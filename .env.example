# =============================================================================
# Environment Variables — copy to .env.local and fill in the values
# =============================================================================

# --- Database (Neon PostgreSQL) ---
DATABASE_URL="postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# --- NextAuth ---
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="cambia-con-openssl-rand-base64-32"

# --- Application encryption key (AES-256-GCM for secrets at rest) ---
# Required. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Cifra: Host.{smtpPass,conciergeApiKey,whatsappAccessToken,sdiApiKey} + PaymentProviderConfig.{stripe,adyen,nexi,sumup}ApiKey
# ⚠️ Perdere questa chiave = perdere tutti i segreti host cifrati. Backup fuori dal repo.
APP_ENCRYPTION_KEY=""

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Otium Week Gestionale"

# --- Email (SMTP) ---
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="noreply@otiumweek.it"
SMTP_PASS="app-password-qui"
SMTP_FROM="Otium Week <noreply@otiumweek.it>"

# --- Cron Jobs ---
CRON_SECRET="genera-un-secret-random"

# --- AI / Ollama (optional, for AI Concierge) ---
OLLAMA_BASE_URL="http://localhost:11434"

# --- Sentry Error Monitoring ---
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# --- SuperAdmin Security (optional - if set, only these IPs can access /superadmin) ---
SUPERADMIN_ALLOWED_IPS=""

# --- E2E Testing (optional) ---
E2E_BASE_URL=""

# --- Vercel Deployment (CI/CD only, set as GitHub secrets) ---
# VERCEL_TOKEN=""
# VERCEL_ORG_ID=""
# VERCEL_PROJECT_ID=""
