{
  "name": "gestionale-otium",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "postinstall": "prisma generate",
    "build": "next build",
    "start": "next start",
    "analyze": "cross-env ANALYZE=true next build",
    "lint": "eslint app components lib hooks scripts --ext .ts,.tsx --max-warnings 600",
    "lint:fix": "eslint app components lib hooks --ext .ts,.tsx --fix",
    "prepare": "husky",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:seed": "ts-node --project tsconfig.scripts.json prisma/seed.ts",
    "seed:e2e": "ts-node --project tsconfig.scripts.json prisma/seed-e2e.ts",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:all": "npm run lint && npm run type-check && npm run test:run",
    "audit:visual": "ts-node --project tsconfig.scripts.json scripts/visual-audit.ts",
    "audit:tenant": "ts-node --project tsconfig.scripts.json scripts/audit-multi-tenant.ts",
    "migrate:host-configs": "ts-node --project tsconfig.scripts.json scripts/migrate-host-configs.ts",
    "migrate:fattura-righe": "ts-node --project tsconfig.scripts.json scripts/migrate-fattura-righe.ts",
    "link:prenotazioni-crm": "ts-node --project tsconfig.scripts.json scripts/link-prenotazioni-crm.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "@prisma/adapter-neon": "^5.11.0",
    "@prisma/client": "^5.11.0",
    "@react-pdf/renderer": "^3.4.2",
    "@sentry/nextjs": "^10.47.0",
    "@types/pdfkit": "^0.17.5",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.0",
    "date-fns": "^3.6.0",
    "framer-motion": "^12.38.0",
    "imapflow": "^1.2.18",
    "lucide-react": "^0.427.0",
    "mailparser": "^3.9.6",
    "next": "^16.2.1",
    "next-auth": "^4.24.7",
    "next-intl": "^4.8.4",
    "nodemailer": "^7.0.7",
    "otpauth": "^9.5.0",
    "pdfkit": "^0.18.0",
    "qrcode": "^1.5.4",
    "react": "^18",
    "react-dom": "^18",
    "recharts": "^2.12.7",
    "sonner": "^2.0.7",
    "swr": "^2.4.1",
    "tailwind-merge": "^2.4.0",
    "tar-stream": "^3.2.0",
    "tesseract.js": "^7.0.0",
    "ws": "^8.17.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.2",
    "@eslint/eslintrc": "^3.3.5",
    "@next/bundle-analyzer": "^16.2.4",
    "@next/eslint-plugin-next": "^16.2.4",
    "@playwright/test": "^1.59.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^20.19.37",
    "@types/nodemailer": "^6.4.17",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/tar-stream": "^3.1.4",
    "@types/ws": "^8.5.10",
    "@vitest/ui": "^4.1.5",
    "autoprefixer": "^10.0.1",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "jsdom": "^29.0.2",
    "lint-staged": "^15.5.2",
    "msw": "^2.13.5",
    "postcss": "^8",
    "prisma": "^5.11.0",
    "tailwindcss": "^3.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5",
    "typescript-eslint": "^8.59.0",
    "vitest": "^4.1.5",
    "vitest-mock-extended": "^4.0.0"
  },
  "prisma": {
    "seed": "ts-node --project tsconfig.scripts.json prisma/seed.ts"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix"
    ]
  }
}
