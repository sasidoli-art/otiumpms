{
  "name": "gestionale-otium",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "postinstall": "prisma generate",
    "build": "next build",
    "start": "next start",
    "lint": "echo 'lint skipped: next lint rimosso in Next 16, TODO migrare a eslint diretto'",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts",
    "seed:e2e": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed-e2e.ts",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:all": "npm run lint && npm run type-check && npm run test:run"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.9.3",
    "@prisma/adapter-neon": "^5.11.0",
    "@prisma/client": "^5.11.0",
    "@react-pdf/renderer": "^3.4.2",
    "@sentry/nextjs": "^10.47.0",
    "@types/pdfkit": "^0.17.5",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.0",
    "date-fns": "^3.6.0",
    "framer-motion": "^12.38.0",
    "imapflow": "^1.2.18",
    "lucide-react": "^0.427.0",
    "mailparser": "^3.9.6",
    "next": "^16.2.1",
    "next-auth": "^4.24.7",
    "next-intl": "^4.8.4",
    "nodemailer": "^7.0.7",
    "otpauth": "^9.5.0",
    "pdfkit": "^0.18.0",
    "qrcode": "^1.5.4",
    "react": "^18",
    "react-dom": "^18",
    "recharts": "^2.12.7",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.4.0",
    "tesseract.js": "^7.0.0",
    "ws": "^8.17.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^20.19.37",
    "@types/nodemailer": "^6.4.17",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/ws": "^8.5.10",
    "@vitest/ui": "^4.1.5",
    "autoprefixer": "^10.0.1",
    "jsdom": "^29.0.2",
    "msw": "^2.13.5",
    "postcss": "^8",
    "prisma": "^5.11.0",
    "tailwindcss": "^3.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5",
    "vitest": "^4.1.5",
    "vitest-mock-extended": "^4.0.0"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  }
