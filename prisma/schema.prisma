// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  SUPERADMIN  // piattaforma — tu e Matteo, gestisce tutto
  ADMIN       // admin piattaforma — gestisce clienti, fatture, pagamenti
  DIREZIONE   // managing director hotel — vede tutto dell'host, report, BI, impostazioni
  HOST        // manager operativo — operatività quotidiana (prenotazioni, check-in, HK, SPA, CRM)
  STAFF       // membro staff con permessi granulari da RuoloStaff
}

enum RuoloStaff {
  MANAGER
  RECEPTIONIST
  HOUSEKEEPING
  SPA_OPERATOR
  RESTAURANT
  CONCIERGE
  READONLY
}

enum PianoTipo {
  LIGHT // €29/mese — B&B base (prenotazioni, check-in, HK, chat, report, email)
  EVENTO_SINGOLO // €49 una tantum
  VISIBILITA_MENSILE // €149/mese — tutti i moduli base + operativi
  PARTNER_PREMIUM // €349/mese — tutto incluso + SPA + POS + AI
}

enum StatoAbbonamento {
  ATTIVO
  SOSPESO
  SCADUTO
  IN_PROVA
}

enum StatoEvento {
  BOZZA
  IN_ATTESA
  APPROVATO
  RIFIUTATO
  SCADUTO
}

enum StatoPagamento {
  IN_ATTESA
  PAGATO
  IN_RITARDO
  ANNULLATO
}

enum StatoFattura {
  BOZZA
  INVIATA
  PAGATA
  SCADUTA
  ANNULLATA
  STORNATA
}

enum CategoriaEvento {
  MUSICA
  ARTE
  TEATRO
  FOOD
  SPORT
  FESTIVAL
  FIERA
  CONFERENZA
  CINEMA
  NATURA
  FAMIGLIA
  ALTRO
}

enum StatoPrenotazione {
  RICHIESTA
  CONFERMATA
  ANNULLATA
  COMPLETATA
  NO_SHOW
}

enum MessaggioMittente {
  HOST
  GUEST
}

enum CanaleMessaggio {
  CHAT
  EMAIL
  WHATSAPP
  SMS
}

enum StatoHK {
  PULITA
  SPORCA
  IN_PULIZIA
  NON_DISTURBARE
  MANUTENZIONE
  FUORI_SERVIZIO
}

enum PrioritaHK {
  BASSA
  NORMALE
  ALTA
  URGENTE
}

enum TipoStruttura {
  EVENTO
  VENUE
  ESPERIENZA
  ALLOGGIO
  SERVIZIO
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  nome      String
  cognome   String
  role      Role     @default(HOST)
  attivo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 2FA
  twoFactorEnabled     Boolean  @default(false)
  twoFactorSecret      String?
  twoFactorBackupCodes String[] @default([])

  host             Host?
  sessioni         Session[]
  tickets          Ticket[]
  staffMemberships StaffMember[]

  // Notifiche superadmin (in-app)
  notificheSuperadmin NotificaSuperadmin[]
  configNotifiche     ConfigNotificaDestinatario[]

  @@map("users")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

/// Configurazione globale della piattaforma Otium, gestita dal SuperAdmin.
/// Singleton: esiste una sola riga con id="singleton".
model PlatformSettings {
  id String @id @default("singleton")

  // ─── Generale ──────────────────────────────────────────────────────────────
  nomePiattaforma String? @default("Otium PMS")
  urlBase         String? @default("https://otium-pms.vercel.app")
  emailSupporto   String?
  emailNoreply    String?

  // ─── SMTP piattaforma (fallback quando host non ha SMTP proprio) ──────────
  smtpHost String?
  smtpPort Int?
  smtpUser String?
  smtpPass String? // cifrato (AES-256-GCM via lib/crypto.ts)
  smtpFrom String? // es. "Otium <noreply@otiumpms.com>"

  // ─── AI Concierge: Platform Key centralizzata ──────────────────────────────
  // Configurazione AI globale usata da tutti gli host (Strategia B "Platform Key").
  // L'host abilita/disabilita dal suo toggle ma NON configura provider/chiave.
  aiProvider String? @default("claude") // "claude" | "openai" | "ollama"
  aiModel    String? @default("claude-haiku-4-5-20251001")
  aiApiKey   String? // Chiave API piattaforma (Anthropic / OpenRouter / OpenAI) — cifrata
  aiBaseUrl  String? // Opzionale: URL gateway custom (OpenRouter, Ollama, ecc.)

  // ─── Piani e prezzi (override runtime di lib/billing.ts PLAN_DEFINITIONS) ─
  /// JSON: { LIGHT: { prezzoMensile, prezzoAnnuale, moduliInclusi[] }, ... }
  /// Se null, usa default hard-coded in lib/billing.ts
  pianiOverride Json?

  // ─── Maintenance mode ─────────────────────────────────────────────────────
  maintenanceMode    Boolean @default(false)
  maintenanceMessage String? @default("Stiamo aggiornando la piattaforma. Torniamo presto.")

  // ─── GDPR retention job state ─────────────────────────────────────────────
  // Tracking del cron notturno di retention. Se ultimaEsecuzioneCompletata=false
  // significa che il job precedente è stato interrotto per timeout Vercel (60s);
  // l'esecuzione successiva riprende dalle policy rimaste.
  ultimaEsecuzioneRetentionAt          DateTime?
  ultimaEsecuzioneRetentionCompletata  Boolean   @default(true)
  ultimaEsecuzioneRetentionReport      Json?

  // ─── Metadata ──────────────────────────────────────────────────────────────
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@map("platform_settings")
}

model Host {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Dati azienda
  nomeAzienda   String
  partitaIva    String?
  codiceFiscale String?
  telefono      String?
  sitoWeb       String?
  indirizzo     String?
  citta         String?
  provincia     String?
  cap           String?
  regione       String?
  logo          String? // URL logo
  note          String?

  // Canali di comunicazione (email SMTP per-host)
  smtpHost      String?
  smtpPort      Int?
  smtpUser      String?
  smtpPass      String?
  emailMittente String? // es. "Villa Otium <info@villa.it>"

  // AI Concierge WhatsApp
  conciergeAttivo       Boolean @default(false)
  conciergeProvider     String? @default("ollama") // "ollama" | "claude" | "openai"
  conciergeApiKey       String? // API key AI dell'host (non della piattaforma)
  conciergeModel        String? @default("llama3.1") // modello AI da usare
  conciergeBaseUrl      String? // URL gateway custom (es. https://openrouter.ai/api/v1 per OpenRouter)
  conciergeSystemPrompt String? // info hotel: orari colazione, checkout, Wi-Fi, ecc.
  conciergeGdprAcceptedAt DateTime? // timestamp accettazione DPA AI da parte dell'host. NULL = non accettato (toggle ON bloccato)
  whatsappNumeroId      String? // Phone Number ID da Meta Cloud API
  whatsappAccessToken   String? // token API WhatsApp Business dell'host
  whatsappVerifyToken   String? // token verifica webhook Meta

  // Wi-Fi Captive Portal — configurazione metodi autenticazione
  wifiAuthPms           Boolean @default(true)   // Login Room + Cognome (da prenotazione)
  wifiAuthCode          Boolean @default(true)   // Login con codice accesso
  wifiAuthComplimentary Boolean @default(false)  // Accesso gratuito a tempo
  wifiComplimentaryMins Int     @default(120)    // Durata accesso gratuito in minuti (default 2h)
  wifiAuthUserForm      Boolean @default(false)  // Registrazione con nome+email
  wifiAuthEmailOnly     Boolean @default(false)  // Login solo con email (match prenotazione per email)
  wifiAuthSocial        Boolean @default(false)  // Social login (Google/Facebook)
  wifiRedirectUrl       String?                  // URL redirect post-login (sito hotel/attività)
  wifiWelcomeMessage    String?                  // Messaggio personalizzato welcome page

  // Email routing — inoltro richieste ospiti a reparti specifici
  emailHousekeeping  String?  // richieste pulizie/biancheria/asciugamani
  emailManutenzione  String?  // segnalazioni guasti/problemi tecnici
  emailRistorazione  String?  // room service/ristorante/colazione
  emailReception     String?  // fallback: tutto quello che non ha categoria specifica

  // Check-in online — timing invio email pre-arrivo
  orePreCheckin Int @default(72) // ore prima dell'arrivo per inviare email check-in online

  // Onboarding
  onboardingCompletato Boolean  @default(false) // legacy — true = fase 1 completata
  onboardingStep       Int      @default(0)     // 0=non iniziato, 1-4=step in corso, 5=completato
  onboardingData       Json?    @default("{}")  // dati parziali salvati tra step

  // DPA (Art. 28 GDPR) — contratto trattamento dati tra host (Titolare) e Otium (Responsabile)
  // Se false, l'host non può accedere a /host/* (redirect a /host/dpa)
  // La storia delle accettazioni è in DPAAccettazione[] (cambio versione → ri-accettazione)
  dpaAccettato    Boolean           @default(false)

  // Checklist post-onboarding (fase 2)
  configSmtp           Boolean  @default(false)
  configBranding       Boolean  @default(false)
  configTariffe        Boolean  @default(false)
  configPasti          Boolean  @default(false)
  configCheckin        Boolean  @default(false)
  primaPrenotazione    Boolean  @default(false)

  // Registration Card HTML (personalizzabile dall'host)
  regCardTerminiHtml    String?
  regCardPrivacyHtml    String?
  regCardSpaTerminiHtml String?
  regCardCampiExtra     Json?

  // Modalità check-in: 'completo' (ospite fa tutto online) | 'leggero' (documenti in reception)
  modalitaCheckin       String?   @default("completo")

  // Moduli attivabili per struttura
  // JSON: { "spa": true, "concierge": false, "lostFound": true, ... }
  moduliAttivi Json? @default("{}")

  // Abbonamento
  piano            PianoTipo        @default(EVENTO_SINGOLO)
  statoAbbonamento StatoAbbonamento @default(IN_PROVA)
  dataInizioAbb    DateTime?
  dataFineAbb      DateTime?

  // Dati fatturazione (possono differire dai dati azienda)
  fattNomeAzienda String?
  fattPartitaIva  String?
  fattIndirizzo   String?
  fattCitta       String?
  fattCap         String?
  fattProvincia   String?
  fattPaese       String? @default("Italia")
  fattEmail       String? // email per invio fatture
  fattPec         String?
  fattCodiceSDI   String?
  regimeFiscale   String? @default("RF01") // RF01=Ordinario, RF02=Minimi, RF04=Agricoltura, ecc.

  // SDI provider configuration
  sdiProvider  String? // 'manuale' | 'aruba' | 'fattureincloud'
  sdiApiKey    String? // API key for the provider
  sdiUsername  String? // Aruba username
  sdiCompanyId String? // FattureInCloud company ID

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  eventi        Evento[]
  abbonamenti   Abbonamento[]
  pagamenti     Pagamento[]
  fatture       Fattura[]
  strutture     Struttura[]
  prenotazioni  Prenotazione[]
  chat          Chat[]
  ospiti        OspiteCRM[]
  segnalazioni  SegnalazioneManutenzione[]
  comunicazioni ComunicazioneStaff[]
  notifiche     Notifica[]
  pacchetti     Pacchetto[]

  // SPA module
  terapistiSpa      TerapistaSpa[]
  cabineSpa         CabinaSpa[]
  trattamentiSpa    TrattamentoSpa[]
  percorsiBenessere PercorsoBenessere[]
  appuntamentiSpa   AppuntamentoSpa[]
  disponibilitaSpa  DisponibilitaTerapista[]

  // AI Concierge
  conversazioniWA ConversazioneWhatsApp[]

  // Promemoria operativi
  traces Trace[]

  // Oggetti smarriti
  oggettiSmarriti OggettoSmarrito[]

  // Magazzino
  articoliMagazzino ArticoloMagazzino[]

  // Biancheria
  richiesteBiancheria RichiestaBiancheria[]

  // Catalogo servizi
  serviziStruttura  ServizioStruttura[]
  pacchettiServizio PacchettoServizio[]

  // Pagamenti
  paymentConfig PaymentProviderConfig?

  // Upselling
  regoleUpsell          RegolaUpsell[]
  upsellingSuggerimenti UpsellingSuggerimento[]

  // Ticket support
  tickets Ticket[]

  // Staff management
  staffMembers StaffMember[]
  staffInvites StaffInvite[]

  // Gift Card
  giftCards GiftCard[]

  // POS
  transazioniPOS TransazionePOS[]

  // Fedelta
  programmiFedelta ProgrammaFedelta[]

  // SPA Waiting List & Turnaway
  waitingListSpa   WaitingListSpa[]
  turnawayTracking TurnawayTracking[]

  // Cassa
  chiusureCassa ChiusuraCassa[]
  incassi       Incasso[]

  // Allotment
  contratti ContrattoAllotment[]

  // Multi-valuta
  valutaBase       String?  @default("EUR")
  valuteAccettate  String[] @default(["EUR"])

  // Wi-Fi module
  wifiDevices      WifiDevice[]
  wifiGuestUsers   WifiGuestUser[]
  wifiAccessLogs   WifiAccessLog[]
  wifiAccessCodes  WifiAccessCode[]
  wifiSessions     WifiSession[]

  // ─── Config estratte (Fase 1 God Object split) ──────────────────────────
  // Durante la migrazione i campi SMTP/Concierge/Wifi/Billing esistono sia su
  // Host (legacy) che su questi modelli dedicati (new). Lib/host-config.ts
  // legge con read-through (new → fallback Host) e scrive dual-write.
  // Al termine della Fase 3 i campi su Host verranno rimossi.
  smtpConfig      HostSmtpConfig?
  conciergeConfig HostConciergeConfig?
  wifiConfig      HostWifiConfig?
  billingInfo     HostBillingInfo?

  // GDPR — richieste di cancellazione (Art. 17)
  richiesteCancellazione RichiestaCancellazione[]

  // GDPR — storico accettazioni DPA (Art. 28)
  dpaAccettazioni DPAAccettazione[]

  // Email automatiche — personalizzazioni per template
  configEmail ConfigEmail[]

  // Alloggiati Web — storico export
  exportAlloggiati ExportAlloggiati[]

  // API keys per integrazioni 3rd-party
  apiKeys ApiKey[]

  // Gruppi prenotazione (matrimoni, convegni)
  gruppiPrenotazione GruppoPrenotazione[]

  // Pagamenti piattaforma (host paga Otium per abbonamento)
  pagamentiPiattaforma PagamentoPiattaforma[]

  // Registratore Telematico (scontrino fiscale)
  registratoreRt    RegistratoreRtConfig?
  scontriniRt       ScontrinoRT[]

  // Prenotazioni ristorante (tavoli)
  prenotazioniRistorante PrenotazioneRistorante[]

  @@map("hosts")
}

// ─── Host config sub-models (extraction from God Object) ──────────────────

model HostSmtpConfig {
  hostId String @id
  host   Host   @relation(fields: [hostId], references: [id], onDelete: Cascade)

  smtpHost      String?
  smtpPort      Int?
  smtpUser      String?
  smtpPass      String? // cifrato (AES-256-GCM via lib/crypto.ts)
  emailMittente String?

  // Email routing — inoltro richieste ospiti a reparti specifici
  emailHousekeeping String?
  emailManutenzione String?
  emailRistorazione String?
  emailReception    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("host_smtp_config")
}

model HostConciergeConfig {
  hostId String @id
  host   Host   @relation(fields: [hostId], references: [id], onDelete: Cascade)

  // AI Concierge
  conciergeAttivo         Boolean   @default(false)
  conciergeProvider       String?   @default("ollama")
  conciergeApiKey         String? // cifrato
  conciergeModel          String?   @default("llama3.1")
  conciergeBaseUrl        String?
  conciergeSystemPrompt   String?
  conciergeGdprAcceptedAt DateTime?

  // Tuning AI
  conciergeTemperatura   Float? @default(0.7)
  conciergeMaxToken      Int?   @default(500)
  conciergeKnowledgeBase String? // FAQ/info estese sulla struttura (separate dal system prompt)

  // Comportamento
  conciergeLinguaDefault          String? @default("it") // fallback lingua risposta
  conciergeAutoEscalation         Int?    @default(10)   // escalate dopo N msg AI senza risoluzione
  conciergeOrariAttiviDa          String? // "HH:MM" — se null: sempre attivo
  conciergeOrariAttiviA           String? // "HH:MM"
  conciergeMessaggioFuoriOrario   String? // risposta quando il bot è offline

  // WhatsApp Business
  whatsappNumeroId    String?
  whatsappAccessToken String? // cifrato
  whatsappVerifyToken String? // plaintext per webhook lookup

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([whatsappVerifyToken]) // per webhook Meta (findFirst)
  @@map("host_concierge_config")
}

model HostWifiConfig {
  hostId String @id
  host   Host   @relation(fields: [hostId], references: [id], onDelete: Cascade)

  // Captive Portal — metodi autenticazione
  wifiAuthPms           Boolean @default(true)
  wifiAuthCode          Boolean @default(true)
  wifiAuthComplimentary Boolean @default(false)
  wifiComplimentaryMins Int     @default(120)
  wifiAuthUserForm      Boolean @default(false)
  wifiAuthEmailOnly     Boolean @default(false)
  wifiAuthSocial        Boolean @default(false)
  wifiRedirectUrl       String?
  wifiWelcomeMessage    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("host_wifi_config")
}

model HostBillingInfo {
  hostId String @id
  host   Host   @relation(fields: [hostId], references: [id], onDelete: Cascade)

  // Dati fatturazione (distinti dai dati azienda dell'Host)
  fattNomeAzienda String?
  fattPartitaIva  String?
  fattIndirizzo   String?
  fattCitta       String?
  fattCap         String?
  fattProvincia   String?
  fattPaese       String? @default("Italia")
  fattEmail       String?
  fattPec         String?
  fattCodiceSDI   String?
  regimeFiscale   String? @default("RF01")

  // SDI provider (Aruba / FattureInCloud / manuale)
  sdiProvider  String?
  sdiApiKey    String? // cifrato
  sdiUsername  String?
  sdiCompanyId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("host_billing_info")
}

/// @deprecated Modulo Eventi rimosso dal PMS (2026-04). Usa `Prenotazione.eventoEsterno`
/// (string libera) o referenzia OtiumWeek.it come source esterno. Il modello
/// resta per non perdere dati legacy; in fase 2 verrà droppato con migration.
model Evento {
  id     String @id @default(cuid())
  hostId String
  host   Host   @relation(fields: [hostId], references: [id], onDelete: Cascade)

  titolo      String
  descrizione String?
  categoria   CategoriaEvento
  stato       StatoEvento     @default(IN_ATTESA)

  dataInizio DateTime
  dataFine   DateTime?
  orario     String?

  luogo     String?
  citta     String
  regione   String
  indirizzo String?

  prezzo       String? // es. "Gratuito", "€12", "da €5"
  urlBiglietti String?
  urlEvento    String?
  immagine     String?

  // Visibilità
  inEvidenza    Boolean  @default(false)
  inNewsletter  Boolean  @default(false)
  visibilitaNaz Boolean  @default(false)
  regioni       String[] @default([]) // regioni target

  // Note admin
  noteAdmin String?

  // Analytics
  visualizzazioni Int @default(0)
  click           Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  analyticsGiorn AnalyticsGiornalieri[]

  @@index([hostId])
  @@index([hostId, stato])
  @@map("eventi")
}

model AnalyticsGiornalieri {
  id              String   @id @default(cuid())
  eventoId        String
  evento          Evento   @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  data            DateTime @db.Date
  visualizzazioni Int      @default(0)
  click           Int      @default(0)

  @@unique([eventoId, data])
  @@map("analytics_giornalieri")
}

model Abbonamento {
  id     String @id @default(cuid())
  hostId String
  host   Host   @relation(fields: [hostId], references: [id], onDelete: Cascade)

  piano         PianoTipo
  stato         StatoAbbonamento
  dataInizio    DateTime
  dataFine      DateTime?
  prezzoMensile Float
  note          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pagamenti Pagamento[]

  @@map("abbonamenti")
}

model Pagamento {
  id            String       @id @default(cuid())
  hostId        String
  host          Host         @relation(fields: [hostId], references: [id], onDelete: Cascade)
  abbonamentoId String?
  abbonamento   Abbonamento? @relation(fields: [abbonamentoId], references: [id])

  importo       Float
  stato         StatoPagamento @default(IN_ATTESA)
  metodo        String? // "Bonifico", "Carta", etc.
  riferimento   String? // numero transazione / CRO
  dataScadenza  DateTime?
  dataPagamento DateTime?
  note          String?
  descrizione   String?

  fattura Fattura?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([hostId])
  @@index([hostId, stato])
  @@map("pagamenti")
}

model Fattura {
  id          String     @id @default(cuid())
  hostId      String
  host        Host       @relation(fields: [hostId], references: [id], onDelete: Cascade)
  pagamentoId String?    @unique
  pagamento   Pagamento? @relation(fields: [pagamentoId], references: [id])

  numero String       @unique // es. "2026/001"
  anno   Int
  stato  StatoFattura @default(BOZZA)

  // Dati cliente al momento emissione
  clienteNome      String
  clientePIva      String?
  clienteCF        String?
  clienteIndirizzo String?
  clienteCitta     String?
  clienteCap       String?
  clienteProvincia String?
  clientePaese     String  @default("Italia")
  clienteEmail     String?
  clientePec       String?
  clienteSDI       String?

  // Righe fattura (JSON array) — LEGACY, sostituito da rigeRel. Da rimuovere dopo migrazione.
  righe Json // [{descrizione, quantita, prezzoUnitario, iva, totale}]
  // Righe fattura (relazione 1:N) — canonica per analytics e report
  rigeRel RigaFattura[]

  imponibile  Float
  iva         Float
  totale      Float
  aliquotaIva Float @default(22)

  dataEmissione DateTime  @default(now())
  dataScadenza  DateTime?
  note          String?

  // SDI (Sistema di Interscambio) integration
  sdiId         String? // provider reference ID
  sdiStato      String? // 'accettata' | 'scartata' | 'in_attesa'
  sdiMessaggio  String? // error message from SDI
  sdiProvider   String? // 'manuale' | 'aruba' | 'fattureincloud'
  sdiInviatoAt  DateTime?
  tipoDocumento String?   @default("TD01") // TD01=fattura, TD04=nota credito

  // Nota di credito: riferimento alla fattura originale
  riferimentoFatturaId String?
  riferimentoFattura   Fattura?  @relation("NoteDiCredito", fields: [riferimentoFatturaId], references: [id])
  noteDiCredito        Fattura[] @relation("NoteDiCredito")

  prenotazioni Prenotazione[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([hostId])
  @@index([hostId, stato])
  @@index([anno])
  @@index([riferimentoFatturaId])
  @@index([deletedAt])
  @@map("fatture")
}

// Riga di fattura — permette report per servizio, IVA media, analytics
model RigaFattura {
  id        String  @id @default(cuid())
  fatturaId String
  fattura   Fattura @relation(fields: [fatturaId], references: [id], onDelete: Cascade)

  ordine          Int    @default(0) // ordinamento nella fattura
  descrizione     String
  quantita        Float
  prezzoUnitario  Float
  aliquotaIva     Float  @default(22) // percentuale (0 = esente)
  totale          Float  // quantita * prezzoUnitario (imponibile)
  naturaEsenzione String? // codice SDI es. N1 (tassa soggiorno), N4, N6, ecc.
  categoria       String? // tassonomia libera: "soggiorno", "spa", "food", "tassa-soggiorno", "extra"

  createdAt DateTime @default(now())

  @@index([fatturaId])
  @@index([fatturaId, ordine])
  @@index([categoria])
  @@map("righe_fattura")
}

// ─── Booking Engine ────────────────────────────────────────────────────────────

model Struttura {
  id     String @id @default(cuid())
  hostId String
  host   Host   @relation(fields: [hostId], references: [id], onDelete: Cascade)

  nome            String
  tipo            TipoStruttura @default(EVENTO)
  descrizione     String?
  indirizzo       String?
  citta           String?
  regione         String?
  capacitaTotale  Int           @default(1) // posti / unità totali
  prezzoBase      Float         @default(0)
  immagini        String[]      @default([])
  attiva          Boolean       @default(true)
  urlPrenotazione String? // slug pubblico per booking page

  // ─── Alloggiati Web (Questura / PS) ───────────────────────────────────────
  alloggiatiAbilitato           Boolean @default(false)
  alloggiatiCodiceStruttura     String? // codice assegnato dalla questura (es. "IT099001")
  alloggiatiComuneIstat         String? // codice ISTAT comune struttura (es. "H501")
  alloggiatiDenominazioneComune String? // nome comune per leggibilità

  unita             UnitaPrenotabile[]
  prenotazioni      Prenotazione[]
  segnalazioni      SegnalazioneManutenzione[]
  pacchetti         Pacchetto[]
  regoleTariffa     RegolaTariffa[]
  configPasti       ConfigPastoStruttura[]
  canaliEsterni     CanaleEsterno[]
  serviziStruttura  ServizioStruttura[]
  pacchettiServizio PacchettoServizio[]
  regoleUpsell      RegolaUpsell[]
  menuGiornalieri   MenuGiornaliero[]
  contrattiAllotment ContrattoAllotment[]
  wifiDevices       WifiDevice[]
  exportAlloggiati  ExportAlloggiati[]
  prenotazioniRistorante PrenotazioneRistorante[]

  // Assegnazione camera: MANUALE (operatore sceglie), AUTOMATICA (sistema in base a HK), AI (concierge AI)
  modalitaAssegnazione String? @default("MANUALE")

  // Booking engine pubblico
  autoConferma        Boolean @default(false) // true = prenotazione diretta CONFERMATA (no revisione)
  cancellazionePolicy String? // testo libero visibile in fase di conferma. Se null: default standard

  // ─── Display firma reception ────────────────────────────────────────────
  firmaDisplayPrenotazioneId String?  // ID prenotazione attualmente in firma sul display
  firmaDisplayAttivaAt       DateTime? // quando è stata attivata

  // ─── Branding (white-label per comunicazioni ospite) ──────────────────────
  logo              String?  // URL logo struttura
  colorePrimario    String?  @default("#4f46e5") // hex
  coloreSecondario  String?  @default("#6366f1") // hex
  coloreSfondo      String? // hex (default applicato runtime: #ffffff)
  coloreTesto       String? // hex (default applicato runtime: #18181b)
  fontFamily        String? // es. "Inter", "Montserrat", "Playfair Display"
  borderRadius      String? // es. "4px", "8px", "16px"
  fotoHero          String?  // URL foto principale (per email + landing)
  messaggioChiusura String?  // es. "Un caro saluto dalla Romagna"
  linkFacebook      String?
  linkInstagram     String?
  linkSitoWeb       String?

  // ─── Custom domain per booking engine (white-label URL) ───────────────────
  // Es. "prenota.villamargherita.it" — richiede CNAME verso cname.otiumweek.com
  // + configurazione domain su Vercel (manuale o via API).
  customDomain       String?  @unique
  customDomainVerificatoAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("strutture")
}

// Unità prenotabile (camera, tavolo, posto, slot orario, ecc.)
model UnitaPrenotabile {
  id          String    @id @default(cuid())
  strutturaId String
  struttura   Struttura @relation(fields: [strutturaId], references: [id], onDelete: Cascade)

  nome             String // es. "Posto VIP", "Camera Standard", "Slot ore 10-12"
  descrizione      String?
  capacita         Int     @default(1)
  lettiExtra       Int     @default(0) // letti aggiuntivi disponibili su richiesta
  piano            Int? // piano dell'edificio (0 = terra, 1, 2, ...)
  prezzoBase       Float   @default(0)
  prezzoLettoExtra Float? // sovrapprezzo per letto extra a notte
  immagine         String? // URL immagine unità
  attiva           Boolean @default(true)

  // Housekeeping
  statoHK       StatoHK   @default(PULITA)
  noteHK        String? // note visibili allo staff HK
  ultimaPulizia DateTime?

  disponibilita       Disponibilita[]
  tariffe             TariffaPeriodo[]
  regoleTariffa       RegolaTariffa[]
  prenotazioni        Prenotazione[]
  taskHK              TaskHK[]
  segnalazioni        SegnalazioneManutenzione[]
  pagamentiSpa        PagamentoSpa[]
  canaliEsterni       CanaleEsterno[]
  dotazioneBiancheria DotazioneBiancheria[]

  @@map("unita_prenotabili")
}

// Disponibilità giornaliera per unità
model Disponibilita {
  id      String           @id @default(cuid())
  unitaId String
  unita   UnitaPrenotabile @relation(fields: [unitaId], references: [id], onDelete: Cascade)

  data             DateTime @db.Date
  postiDisponibili Int      @default(1)
  postiOccupati    Int      @default(0)
  chiuso           Boolean  @default(false) // blocco manuale host
  noteInterno      String?

  @@unique([unitaId, data])
  @@map("disponibilita")
}

// Tariffa per periodo (alta stagione, weekend, promo ecc.)
model TariffaPeriodo {
  id      String           @id @default(cuid())
  unitaId String
  unita   UnitaPrenotabile @relation(fields: [unitaId], references: [id], onDelete: Cascade)

  nome       String // es. "Alta stagione", "Promo Pasqua"
  dataInizio DateTime @db.Date
  dataFine   DateTime @db.Date
  prezzo     Float
  colore     String?  @default("#6366f1") // per il calendario

  @@map("tariffe_periodo")
}

// Regola tariffa automatica (weekend, stagione, festivi)
model RegolaTariffa {
  id          String            @id @default(cuid())
  strutturaId String
  struttura   Struttura         @relation(fields: [strutturaId], references: [id], onDelete: Cascade)
  unitaId     String? // null = tutte le unità della struttura
  unita       UnitaPrenotabile? @relation(fields: [unitaId], references: [id], onDelete: Cascade)

  nome     String // es. "Weekend +20%", "Alta stagione agosto"
  tipo     TipoRegolaTariffa // WEEKEND, STAGIONE, FESTIVO
  attiva   Boolean           @default(true)
  priorita Int               @default(0) // regola con priorità più alta vince

  // Modificatore prezzo
  modificatore TipoModificatore // PERCENTUALE, FISSO
  valore       Float // es. 20 = +20% oppure 30 = +€30

  // Periodo (solo per STAGIONE)
  meseInizio   Int? // 1-12
  giornoInizio Int? // 1-31
  meseFine     Int? // 1-12
  giornoFine   Int? // 1-31

  // Giorni settimana (solo per WEEKEND / personalizzato) — 0=Lun, 6=Dom
  giorniSettimana Int[] @default([]) // es. [4,5] = Ven+Sab, [5,6] = Sab+Dom

  // Durata soggiorno (solo per DURATA) — notti minime per attivare lo sconto
  nottiMinime Int? // es. 3 = sconto attivo per soggiorni >= 3 notti

  createdAt DateTime @default(now())

  @@map("regole_tariffa")
}

enum TipoRegolaTariffa {
  WEEKEND // applica a giorni settimana selezionati
  STAGIONE // applica a range date annuale (si ripete ogni anno)
  FESTIVO // applica a date specifiche (Natale, Capodanno, ecc.)
  DURATA // sconto per soggiorni lunghi (es. 3+ notti -10%, 7+ notti -20%)
}

enum TipoModificatore {
  PERCENTUALE // +X% sul prezzo base
  FISSO // +€X sul prezzo base
}

// Prenotazione / richiesta da ospite
model Prenotazione {
  id          String            @id @default(cuid())
  hostId      String
  host        Host              @relation(fields: [hostId], references: [id])
  strutturaId String?
  struttura   Struttura?        @relation(fields: [strutturaId], references: [id])
  unitaId     String?
  unita       UnitaPrenotabile? @relation(fields: [unitaId], references: [id])

  // PIN ospite — chiave universale del soggiorno (4 cifre, unique per host)
  // Auto-generato alla conferma, valido check-in → check-out.
  // Usato per: WiFi login, directory camera, concierge WhatsApp, richieste, SPA, checkout.
  pin           String?

  // Dati ospite
  guestNome     String
  guestCognome  String
  guestEmail    String
  guestTelefono String?
  guestNote     String?

  // Evento di riferimento (stringa libera, non legato a model Evento interno)
  // Es. "Salone del Mobile 2026", "Matrimonio Rossi", link a OtiumWeek.it
  eventoEsterno String?

  // Gruppo — quando fa parte di una prenotazione di gruppo (matrimonio, convegno)
  gruppoPrenotazioneId String?
  gruppoPrenotazione   GruppoPrenotazione? @relation(fields: [gruppoPrenotazioneId], references: [id], onDelete: SetNull)

  // Dettagli prenotazione
  dataArrivo   DateTime          @db.Date
  dataPartenza DateTime?         @db.Date
  numOspiti    Int               @default(1)
  stato        StatoPrenotazione @default(RICHIESTA)
  fonte        String?           @default("Diretto") // "Diretto", "Web", "Tel", "Email"

  // Economici
  prezzoTotale   Float?
  acconto        Float?
  tassaSoggiorno Float? // tassa di soggiorno: € per notte
  noteInterne    String?

  // ─── Dati anagrafici ospite per Alloggiati Web ───────────────────────────
  guestSesso               String? // "M" o "F"
  guestDataNascita         DateTime? @db.Date
  guestLuogoNascita        String? // nome comune (display)
  guestComuneNascitaIstat  String? // codice ISTAT comune nascita
  guestProvinciaNascita    String? // sigla 2 lettere
  guestStatoNascitaIstat   String?   @default("100000100") // ISTAT stato nascita
  guestCittadinanzaIstat   String?   @default("100000100") // ISTAT cittadinanza
  guestTipoDocumento       String? // PPORT, IDENTE, PATEN, PATEN_INT, ALTRO
  guestNumeroDocumento     String?
  guestLuogoRilascio       String? // nome comune (display)
  guestComuneRilascioIstat String? // ISTAT comune rilascio
  guestProvinciaRilascio   String? // sigla 2 lettere
  guestStatoRilascioIstat  String? // ISTAT stato rilascio
  guestCodiceFiscale       String? // solo per italiani
  fotoDocumentoFronte      String?
  fotoDocumentoRetro       String?

  // Notifiche / Email automatiche
  emailInviata          Boolean @default(false)
  reminderInviato       Boolean @default(false) // pre_checkin (X ore prima, default 72h)
  reminderArrivoInviato Boolean @default(false) // reminder_arrivo (24h prima)
  followUpInviato       Boolean @default(false) // follow-up post-soggiorno inviato

  // Lingua preferita ospite (per email multilingua)
  guestLingua String? @default("it") // "it", "en", "de", "fr", "es"

  // Registration Card (firma digitale)
  regCardFirmata      Boolean   @default(false)
  regCardFirmaBase64  String?
  regCardAccTermini   Boolean   @default(false)
  regCardAccPrivacy   Boolean   @default(false)
  regCardAccMarketing Boolean   @default(false)
  regCardDataFirma    DateTime?

  // Self check-in ospite
  checkInToken      String? @unique
  checkInCompletato Boolean @default(false) // legacy: true se ONLINE_COMPLETATO o VERIFICATO
  statoCheckIn      StatoCheckIn @default(NON_INIZIATO)
  verificatoAt      DateTime?
  verificatoDa      String? // userId operatore reception

  chat              Chat?
  fattura           Fattura?                @relation(fields: [fatturaId], references: [id])
  fatturaId         String?
  appuntamentiSpa   AppuntamentoSpa[]
  conversazioniWA   ConversazioneWhatsApp[]
  accompagnatori    Accompagnatore[]
  traces            Trace[]
  oggettiSmarriti   OggettoSmarrito[]
  alertOspite       AlertOspite[]
  pianoPasto        PastoPrenotazione?
  addebiti          AddebitoPrenotazione[]
  pagamentiCheckout PagamentoCheckout[]
  proposteUpsell    PropostaUpsell[]
  upsellingConversioni UpsellingConversione[]
  movimentiFedelta  MovimentoPunti[]
  sceltePasto       SceltaPastoOspite[]
  transazioniPOS    TransazionePOS[]
  waitingListSpa    WaitingListSpa[]
  incassi           Incasso[]
  prenotazioniRistorante PrenotazioneRistorante[] @relation("PrenotazioneRistoranteSoggiorno")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Indici per le query più frequenti nei route handler
  @@unique([hostId, pin])
  @@index([hostId])
  @@index([hostId, stato])
  @@index([hostId, dataArrivo]) // dashboard arrivi + calendario
  @@index([hostId, dataPartenza]) // dashboard partenze + retention 40gg
  @@index([hostId, statoCheckIn]) // check-in online da verificare
  @@index([unitaId, dataArrivo]) // calendario per-camera + conflict detection booking
  @@index([guestEmail])
  @@index([gruppoPrenotazioneId])
  @@index([deletedAt])
  @@map("prenotazioni")
}

// ─── Gruppo prenotazioni (matrimoni, convegni, gruppi turistici) ─────────────
//
// Raggruppa N `Prenotazione` sotto un master con referente unico.
// Utile per:
//   - fatturazione unica al capogruppo
//   - reportistica per evento/gruppo
//   - comunicazioni bulk a tutti i partecipanti

model GruppoPrenotazione {
  id     String @id @default(cuid())
  hostId String
  host   Host   @relation(fields: [hostId], references: [id], onDelete: Cascade)

  nome              String // "Matrimonio Rossi-Bianchi" / "Convegno AIMS 2026"
  referenteNome     String
  referenteCognome  String
  referenteEmail    String
  referenteTelefono String?

  dataArrivo   DateTime  @db.Date
  dataPartenza DateTime? @db.Date
  numOspitiTotali Int @default(0)

  // Prezzo complessivo + eventuale sconto gruppo
  prezzoTotale  Float?
  scontoPercent Float?

  note     String?
  eventoEsterno String? // link stringa libera a evento esterno (es. sito matrimonio)

  prenotazioni Prenotazione[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([hostId])
  @@index([dataArrivo])
  @@index([deletedAt])
  @@map("gruppi_prenotazione")
}

enum StatoCheckIn {
  NON_INIZIATO       // ospite non ha fatto nulla
  ONLINE_COMPLETATO  // ospite ha firmato online, serve verifica reception (controllo documento)
  VERIFICATO         // operatore in reception ha verificato il documento fisicamente
}

// ─── Piani Pasto & Ristorazione ───────────────────────────────────────────────

enum TipoPasto {
  COLAZIONE
  PRANZO
  CENA
}

enum PianoPasto {
  SOLO_PERNOTTAMENTO // Room Only
  PERNOTTAMENTO_COLAZIONE // B&B
  MEZZA_PENSIONE // HB: colazione + cena
  PENSIONE_COMPLETA // FB: colazione + pranzo + cena
  ALL_INCLUSIVE // tutto incluso
}

// Configurazione pasti della struttura (cosa offre, a che prezzo)
model ConfigPastoStruttura {
  id          String    @id @default(cuid())
  strutturaId String
  struttura   Struttura @relation(fields: [strutturaId], references: [id], onDelete: Cascade)

  tipoPasto     TipoPasto
  disponibile   Boolean   @default(true)
  orarioInizio  String? // "07:30"
  orarioFine    String? // "10:00"
  prezzo        Float     @default(0) // prezzo per persona se non incluso nel piano
  prezzoRidotto Float? // prezzo bambini/ridotto
  luogo         String? // "Sala colazioni piano terra", "Ristorante La Terrazza"
  note          String? // "Buffet", "Servito al tavolo", ecc.

  // Capacita ristorante: numero massimo coperti contemporanei per questa fascia
  // (usato dal booking ristorante pubblico per calcolare slot disponibili).
  // null = illimitato / non gestito (es. colazione B&B)
  maxCoperti    Int?

  createdAt DateTime @default(now())

  @@unique([strutturaId, tipoPasto])
  @@map("config_pasto_struttura")
}

// Piano pasto assegnato a una prenotazione
model PastoPrenotazione {
  id             String       @id @default(cuid())
  prenotazioneId String
  prenotazione   Prenotazione @relation(fields: [prenotazioneId], references: [id], onDelete: Cascade)

  piano   PianoPasto @default(PERNOTTAMENTO_COLAZIONE)
  incluso Boolean    @default(true) // se il pasto è incluso nel prezzo o va addebitato extra
  note    String? // "Ospite celiaco", "Vegano", "Intolleranza lattosio"

  // Override prezzo (se diverso dal listino struttura)
  sovraprezzoGiornaliero Float? // extra per persona/giorno se non incluso

  // Pasti specifici aggiunti/rimossi (override del piano)
  pastiExtra   TipoPasto[] @default([]) // pasti aggiunti oltre al piano
  pastiEsclusi TipoPasto[] @default([]) // pasti esclusi dal piano

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([prenotazioneId])
  @@map("pasti_prenotazione")
}

// ─── Prenotazione ristorante (tavolo) ─────────────────────────────────────────
// Ospite esterno (non necessariamente in-house) prenota un tavolo al ristorante.
// Si distingue da PastoPrenotazione (piano pasto di un soggiorno) e da
// SceltaPastoOspite (scelta piatti in-house).
model PrenotazioneRistorante {
  id          String    @id @default(cuid())
  hostId      String
  host        Host      @relation(fields: [hostId], references: [id], onDelete: Cascade)
  strutturaId String
  struttura   Struttura @relation(fields: [strutturaId], references: [id], onDelete: Cascade)

  guestNome     String
  guestCognome  String
  guestEmail    String
  guestTelefono String?

  dataOra    DateTime // data e ora della prenotazione (slot di 30 min)
  numPersone Int
  note       String? // "tavolo esterno", "compleanno", "allergia arachidi"

  stato String @default("CONFERMATA") // CONFERMATA | ANNULLATA | COMPLETATA | NO_SHOW

  // Collegamento opzionale al soggiorno (se l'ospite e` in-house)
  prenotazioneId String?
  prenotazione   Prenotazione? @relation("PrenotazioneRistoranteSoggiorno", fields: [prenotazioneId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([hostId, dataOra])
  @@index([strutturaId, dataOra])
  @@index([prenotazioneId])
  @@map("prenotazioni_ristorante")
}

// ─── Magazzino (Inventory) ────────────────────────────────────────────────────

model ArticoloMagazzino {
  id     String @id @default(cuid())
  hostId String
  host   Host   @relation(fields: [hostId], references: [id], onDelete: Cascade)

  nome      String // "Asciugamano grande", "Lenzuola singolo", "Sapone 30ml", "Minibar Cola"
  categoria String @default("ALTRO") // BIANCHERIA, PULIZIA, MINIBAR, AMENITIES, CANCELLERIA, MANUTENZIONE, ALTRO
  unita     String @default("pz") // pz, kg, lt, rotoli, conf

  // Scorte
  quantita       Int    @default(0) // giacenza attuale
  scorteMinime   Int    @default(0) // soglia allarme riordino
  scorteOttimali Int? // livello ideale
  costoUnitario  Float? // costo acquisto unitario

  // Info
  fornitore      String? // nome fornitore
  codiceArticolo String? // SKU / codice interno
  ubicazione     String? // "Magazzino piano -1", "Ripostiglio piano 2"
  note           String?

  movimenti MovimentoMagazzino[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([hostId, categoria])
  @@map("articoli_magazzino")
}

model MovimentoMagazzino {
  id         String            @id @default(cuid())
  articoloId String
  articolo   ArticoloMagazzino @relation(fields: [articoloId], references: [id], onDelete: Cascade)

  tipo      String // CARICO, SCARICO, RETTIFICA, CONSUMO
  quantita  Int // positivo per carico, negativo per scarico
  motivo    String? // "Rifornimento", "Consumo camera 204", "Inventario", "Rotto"
  operatore String? // chi ha fatto il movimento

  createdAt DateTime @default(now())

  @@index([articoloId, createdAt])
  @@map("movimenti_magazzino")
}

// ─── Pagamenti Checkout (POS/contanti/bonifico) ──────────────────────────────

// Configurazione provider pagamento per host
model PaymentProviderConfig {
  id     String @id @default(cuid())
  hostId String @unique
  host   Host   @relation(fields: [hostId], references: [id], onDelete: Cascade)

  // Provider attivo: MANUALE, STRIPE, ADYEN, NEXI, SUMUP
  providerAttivo String @default("MANUALE")

  // Stripe Terminal
  stripeSecretKey  String?
  stripeLocationId String?
  stripeReaderId   String?

  // Adyen
  adyenApiKey          String?
  adyenMerchantAccount String?
  adyenTerminalId      String?
  adyenEnvironment     String? @default("test") // "test" | "live"

  // Nexi
  nexiApiKey     String?
  nexiTerminalId String?

  // SumUp
  sumupApiKey   String?
  sumupDeviceId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("payment_provider_config")
}

// Singola transazione di pagamento al checkout
model PagamentoCheckout {
  id             String       @id @default(cuid())
  hostId         String
  prenotazioneId String
  prenotazione   Prenotazione @relation(fields: [prenotazioneId], references: [id], onDelete: Cascade)

  // Importo
  importo Float
  divisa  String @default("EUR")

  // Metodo
  metodo   String // CARTA, CONTANTI, BONIFICO, CAMERA_CREDIT, ASSEGNO, ALTRO
  provider String @default("MANUALE") // MANUALE, STRIPE, ADYEN, NEXI, SUMUP

  // Riferimenti
  riferimentoEsterno String? // transaction ID dal POS/provider
  ultime4Cifre       String? // ultime 4 cifre carta
  circuito           String? // VISA, MASTERCARD, AMEX, BANCOMAT
  autorizzazione     String? // codice autorizzazione

  // Stato
  stato  String  @default("COMPLETATO") // PENDENTE, COMPLETATO, RIFIUTATO, ANNULLATO, RIMBORSATO
  errore String? // motivo se rifiutato

  // Chi ha gestito
  operatore String?
  note      String?

  createdAt DateTime @default(now())

  @@index([prenotazioneId])
  @@index([hostId, createdAt])
  @@map("pagamenti_checkout")
}

// ─── Catalogo Servizi & Prodotti (con IVA) ────────────────────────────────────

// Singolo servizio/prodotto offerto dalla struttura (completamente personalizzabile)
model ServizioStruttura {
  id          String     @id @default(cuid())
  hostId      String
  host        Host       @relation(fields: [hostId], references: [id], onDelete: Cascade)
  strutturaId String? // null = disponibile in tutte le strutture dell'host
  struttura   Struttura? @relation(fields: [strutturaId], references: [id], onDelete: Cascade)

  nome           String // "Colazione buffet", "Degustazione vini", "Bottiglia Barolo", "Massaggio 60min"
  descrizione    String?
  categoria      String // libero: ALLOGGIO, RISTORAZIONE, BEVANDE, SPA, SERVIZI, PRODOTTI, PACCHETTO, ALTRO
  sottocategoria String? // libero: "Colazione", "Cena", "Vino rosso", "Massaggio", ecc.

  // Prezzo & IVA
  prezzo      Float  @default(0)
  aliquotaIva Float  @default(22) // 4, 5, 10, 22, 0 (esente)
  unitaMisura String @default("a persona") // "a persona", "a camera", "a notte", "forfait", "a consumo", "a bottiglia"

  // Disponibilità
  attivo            Boolean @default(true)
  prenotabileOnline Boolean @default(false) // visibile nel booking pubblico
  immagine          String? // URL immagine

  // Per servizi ricorrenti (colazione, pranzo, cena)
  ricorrente   Boolean @default(false) // se true, si addebita per ogni notte
  orarioInizio String? // "07:30"
  orarioFine   String? // "10:00"
  luogo        String? // "Sala colazioni piano terra"

  // Relazioni
  addebitiPrenotazione AddebitoPrenotazione[]
  vociPacchetto        VocePacchetto[]
  vociPOS              VocePOS[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([hostId, categoria])
  @@index([strutturaId])
  @@map("servizi_struttura")
}

// Pacchetto = combinazione di servizi con prezzo speciale
model PacchettoServizio {
  id          String     @id @default(cuid())
  hostId      String
  host        Host       @relation(fields: [hostId], references: [id], onDelete: Cascade)
  strutturaId String?
  struttura   Struttura? @relation(fields: [strutturaId], references: [id], onDelete: Cascade)

  nome              String // "Weekend Degustazione", "Romantico", "Business Pack"
  descrizione       String?
  immagine          String?
  prezzo            Float   @default(0) // prezzo pacchetto (può essere diverso dalla somma dei servizi)
  prezzoOriginale   Float? // prezzo pieno senza sconto (per mostrare il risparmio)
  attivo            Boolean @default(true)
  prenotabileOnline Boolean @default(false)

  // Validità
  dataInizio DateTime? @db.Date
  dataFine   DateTime? @db.Date

  voci                 VocePacchetto[]
  addebitiPrenotazione AddebitoPrenotazione[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([hostId])
  @@map("pacchetti_servizio")
}

// Singola voce dentro un pacchetto
model VocePacchetto {
  id          String            @id @default(cuid())
  pacchettoId String
  pacchetto   PacchettoServizio @relation(fields: [pacchettoId], references: [id], onDelete: Cascade)
  servizioId  String
  servizio    ServizioStruttura @relation(fields: [servizioId], references: [id], onDelete: Cascade)

  quantita Int     @default(1)
  incluso  Boolean @default(true) // se false, è opzionale/extra

  @@map("voci_pacchetto")
}

// Addebito di un servizio/pacchetto su una prenotazione (conto ospite)
model AddebitoPrenotazione {
  id             String       @id @default(cuid())
  prenotazioneId String
  prenotazione   Prenotazione @relation(fields: [prenotazioneId], references: [id], onDelete: Cascade)

  // Può essere un servizio singolo O un pacchetto
  servizioId  String?
  servizio    ServizioStruttura? @relation(fields: [servizioId], references: [id])
  pacchettoId String?
  pacchetto   PacchettoServizio? @relation(fields: [pacchettoId], references: [id])

  descrizione    String // descrizione leggibile in fattura
  quantita       Int      @default(1)
  prezzoUnitario Float
  aliquotaIva    Float    @default(22)
  totale         Float // quantita × prezzoUnitario
  data           DateTime @default(now()) @db.Date // data dell'addebito

  // Chi ha addebitato
  addebitatoDa String? // "Reception", "Ristorante", "SPA", "Minibar", "Sistema"
  note         String?

  createdAt DateTime @default(now())

  @@index([prenotazioneId])
  @@map("addebiti_prenotazione")
}

// ─── Channel Manager (connessioni iCal con OTA) ──────────────────────────────

model CanaleEsterno {
  id          String            @id @default(cuid())
  strutturaId String
  struttura   Struttura         @relation(fields: [strutturaId], references: [id], onDelete: Cascade)
  unitaId     String?
  unita       UnitaPrenotabile? @relation(fields: [unitaId], references: [id], onDelete: SetNull)

  nome    String // "Booking.com", "Airbnb", "VRBO", "Google Calendar", ecc.
  urlIcal String // URL feed iCal da importare
  attivo  Boolean @default(true)
  colore  String  @default("#f59e0b") // colore nel calendario

  // Stato sync
  ultimoSync      DateTime?
  ultimoSyncOk    Boolean   @default(true)
  ultimoSyncError String?
  eventiImportati Int       @default(0)

  // Prenotazioni importate da questo canale
  prenotazioniImportate PrenotazioneCanale[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([strutturaId])
  @@map("canali_esterni")
}

// Singola prenotazione/blocco importato da un canale iCal
model PrenotazioneCanale {
  id       String        @id @default(cuid())
  canaleId String
  canale   CanaleEsterno @relation(fields: [canaleId], references: [id], onDelete: Cascade)

  uidEvento   String // UID iCal dell'evento (per dedup)
  sommario    String // SUMMARY dell'evento ("Booked", "Not available", nome ospite)
  dataInizio  DateTime @db.Date
  dataFine    DateTime @db.Date
  descrizione String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([canaleId, uidEvento])
  @@index([canaleId])
  @@map("prenotazioni_canale")
}

// ─── Alert Ospite (avvisi automatici a check-in/checkout) ─────────────────────

model AlertOspite {
  id             String       @id @default(cuid())
  hostId         String
  prenotazioneId String
  prenotazione   Prenotazione @relation(fields: [prenotazioneId], references: [id], onDelete: Cascade)

  messaggio     String // "Ospite VIP — upgrade se possibile", "Allergia noci — avvisare cucina"
  tipo          String    @default("INFO") // INFO, WARNING, DANGER
  triggerEvento String // "CHECKIN", "CHECKOUT", "ACCESSO" (quando si apre la prenotazione)
  attivo        Boolean   @default(true)
  vistoAt       DateTime? // quando l'operatore l'ha visto/confermato
  vistoDa       String?

  createdAt DateTime @default(now())

  @@index([prenotazioneId, triggerEvento])
  @@map("alert_ospite")
}

// ─── Oggetti Smarriti (Lost & Found) ──────────────────────────────────────────

enum StatoOggettoSmarrito {
  IN_CUSTODIA // trovato, in attesa
  RESTITUITO // riconsegnato al proprietario
  SPEDITO // spedito al proprietario
  NON_RECLAMATO // nessuno l'ha reclamato (dopo N giorni)
  SMALTITO // eliminato/donato
}

model OggettoSmarrito {
  id     String @id @default(cuid())
  hostId String
  host   Host   @relation(fields: [hostId], references: [id], onDelete: Cascade)

  // Cosa
  descrizione String // "Orologio da polso argento", "Zaino nero North Face"
  categoria   String  @default("ALTRO") // ABBIGLIAMENTO, ELETTRONICA, DOCUMENTI, GIOIELLI, BAGAGLIO, ALTRO
  foto        String? // URL foto

  // Dove e quando trovato
  luogoRitrovamento String? // "Camera 204", "Ristorante", "Lobby", "Parcheggio"
  dataRitrovamento  DateTime @default(now()) @db.Date
  trovatoDa         String? // nome di chi l'ha trovato

  // Proprietario (se identificato)
  proprietarioNome     String?
  proprietarioEmail    String?
  proprietarioTelefono String?
  prenotazioneId       String? // collegamento opzionale a prenotazione
  prenotazione         Prenotazione? @relation(fields: [prenotazioneId], references: [id], onDelete: SetNull)

  // Stato
  stato            StatoOggettoSmarrito @default(IN_CUSTODIA)
  luogoCustodia    String? // "Cassaforte reception", "Magazzino piano -1"
  dataRestituzione DateTime?
  noteRestituzione String? // "Spedito via corriere DHL tracking XXX"
  note             String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([hostId, stato])
  @@map("oggetti_smarriti")
}

// ─── Upselling Camera ────────────────────────────────────────────────────────

model RegolaUpsell {
  id          String     @id @default(cuid())
  hostId      String
  host        Host       @relation(fields: [hostId], references: [id], onDelete: Cascade)
  strutturaId String?
  struttura   Struttura? @relation(fields: [strutturaId], references: [id], onDelete: Cascade)

  nome      String // "Standard → Deluxe", "Doppia → Suite"
  daUnitaId String? // camera/tipo di partenza (null = qualsiasi)
  aUnitaId  String // camera/tipo target upgrade

  tipoSupplemento String @default("FISSO") // FISSO (€/notte), PERCENTUALE
  supplemento     Float  @default(0)

  // Incentivo operatore
  incentivo    Float  @default(0) // € premio per operatore
  incentivoPct Float? // % del supplemento

  // Limiti
  maxOccupazione Float?  @default(80)
  maxNotti       Int?
  soloCheckIn    Boolean @default(true)
  attiva         Boolean @default(true)

  proposte  PropostaUpsell[]
  createdAt DateTime         @default(now())

  @@index([hostId])
  @@map("regole_upsell")
}

model PropostaUpsell {
  id             String       @id @default(cuid())
  regolaId       String
  regola         RegolaUpsell @relation(fields: [regolaId], references: [id], onDelete: Cascade)
  prenotazioneId String
  prenotazione   Prenotazione @relation(fields: [prenotazioneId], references: [id], onDelete: Cascade)

  daCameraNome      String
  aCameraNome       String
  supplementoNotte  Float
  supplementoTotale Float

  stato          String  @default("PROPOSTA") // PROPOSTA, ACCETTATA, RIFIUTATA
  propostaDa     String // operatore, "AI Concierge", "Sistema"
  rispostaOspite String?

  incentivoOperatore Float     @default(0)
  accettatoAt        DateTime?
  createdAt          DateTime  @default(now())

  @@index([prenotazioneId])
  @@index([propostaDa, createdAt])
  @@map("proposte_upsell")
}

// ─── Upselling catalogo (multi-touchpoint, multi-tipo) ───────────────────────
//
// Affianca `RegolaUpsell` (che gestisce solo camera upgrades per-prenotazione)
// con un catalogo generico di offerte mostrabili in più punti del guest journey:
// post-prenotazione, email pre-arrivo, check-in online, benvenuto WA, in-house.

enum UpsellingTipo {
  UPGRADE_CAMERA
  TRATTAMENTO_SPA
  PIANO_PASTO
  LATE_CHECKOUT
  EARLY_CHECKIN
  SERVIZIO_EXTRA
  PACCHETTO
  RISTORANTE
  ALTRO
}

enum UpsellingTouchpoint {
  POST_PRENOTAZIONE
  EMAIL_PRE_ARRIVO
  CHECKIN_ONLINE
  BENVENUTO_WHATSAPP
  IN_HOUSE
}

model UpsellingSuggerimento {
  id     String @id @default(cuid())
  hostId String
  host   Host   @relation(fields: [hostId], references: [id], onDelete: Cascade)

  tipo        UpsellingTipo
  titolo      String
  descrizione String?
  immagine    String? // URL immagine per card

  // Prezzo: uno dei due (prezzo fisso in € O percentuale del totale)
  prezzo            Float?
  prezzoPercentuale Float?

  // Link opzionali a risorse catalogo esistenti (usati per applicare la conversione)
  trattamentoSpaId String?
  servizioId       String?
  pacchettoId      String?
  unitaTargetId    String? // per UPGRADE_CAMERA

  // Targeting
  posizione  UpsellingTouchpoint[] @default([])
  condizioni Json?                 // { minNotti, maxNotti, cameraTipo[], pianoPasto[], giorniPrimaArrivo{min,max}, ospiteRicorrente }
  priorita   Int                   @default(0)

  attivo Boolean @default(true)

  conversioni UpsellingConversione[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([hostId, attivo])
  @@map("upselling_suggerimenti")
}

model UpsellingConversione {
  id             String                @id @default(cuid())
  suggerimentoId String
  suggerimento   UpsellingSuggerimento @relation(fields: [suggerimentoId], references: [id], onDelete: Cascade)

  prenotazioneId String?
  prenotazione   Prenotazione? @relation(fields: [prenotazioneId], references: [id], onDelete: SetNull)

  touchpoint UpsellingTouchpoint
  accettato  Boolean             @default(false) // false = vista, true = accettata
  importo    Float? // € effettivamente applicati (solo se accettato)

  datiApplicazione Json? // tracking effetto: { appuntamentoSpaId, addebitoId, ... }

  createdAt DateTime @default(now())

  @@index([suggerimentoId])
  @@index([prenotazioneId])
  @@index([suggerimentoId, accettato])
  @@map("upselling_conversioni")
}

// ─── Biancheria & Lavanderia ──────────────────────────────────────────────────

// Dotazione standard per camera/unità (quanta biancheria serve per N ospiti)
model DotazioneBiancheria {
  id      String            @id @default(cuid())
  hostId  String
  unitaId String? // null = default per tutte le unità
  unita   UnitaPrenotabile? @relation(fields: [unitaId], references: [id], onDelete: Cascade)

  articolo          String // "Lenzuola matrimoniale", "Asciugamano grande", "Tappetino bagno", ecc.
  quantitaPerOspite Int    @default(1) // quanti pezzi per ospite
  quantitaFissa     Int    @default(0) // pezzi fissi per camera (indipendenti da ospiti)
  categoria         String @default("BIANCHERIA") // BIANCHERIA, BAGNO, ACCESSORI

  createdAt DateTime @default(now())

  @@index([hostId])
  @@map("dotazione_biancheria")
}

// Richiesta biancheria generata (per giorno, per camera)
model RichiestaBiancheria {
  id     String @id @default(cuid())
  hostId String
  host   Host   @relation(fields: [hostId], references: [id], onDelete: Cascade)

  dataConsegna DateTime @db.Date // giorno per cui serve la biancheria
  generataIl   DateTime @default(now())

  // Dettaglio righe (JSON): [{camera, ospiti, articoli: [{nome, quantita}]}]
  righe Json

  totaleArticoli Int @default(0) // somma totale pezzi
  totaleCamere   Int @default(0)

  // Stato
  stato       String    @default("BOZZA") // BOZZA, INVIATA, CONFERMATA, COMPLETATA
  canaleInvio String? // EMAIL, WHATSAPP, SMS, CHAT
  inviatoA    String? // email/numero destinatario
  inviatoIl   DateTime?
  note        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([hostId, dataConsegna])
  @@map("richieste_biancheria")
}

// ─── Promemoria Operativi (Traces) ────────────────────────────────────────────

enum StatoTrace {
  APERTO
  IN_CORSO
  COMPLETATO
  ANNULLATO
}

enum PrioritaTrace {
  BASSA
  NORMALE
  ALTA
  URGENTE
}

model Trace {
  id     String @id @default(cuid())
  hostId String
  host   Host   @relation(fields: [hostId], references: [id], onDelete: Cascade)

  // Collegamento opzionale a prenotazione
  prenotazioneId String?
  prenotazione   Prenotazione? @relation(fields: [prenotazioneId], references: [id], onDelete: SetNull)

  // Contenuto
  titolo      String
  descrizione String?
  reparto     String // "RECEPTION", "HOUSEKEEPING", "MANUTENZIONE", "SPA", "RISTORANTE", "DIREZIONE", "ALTRO"
  priorita    PrioritaTrace @default(NORMALE)
  stato       StatoTrace    @default(APERTO)

  // Scadenza e assegnazione
  dataScadenza DateTime? @db.Date
  oraScadenza  String? // "HH:mm" — per trace time-sensitive (es. "preparare camera entro le 14:00")
  assegnatoA   String? // nome operatore/reparto
  creatoDa     String? // nome di chi ha creato il trace

  // Trigger automatico (quando mostrare il promemoria)
  triggerEvento String? // "CHECKIN", "CHECKOUT", "ARRIVO_GIORNO", null = sempre visibile

  // Risoluzione
  completatoAt    DateTime?
  completatoDa    String? // chi ha marcato come completato
  noteRisoluzione String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([hostId, stato])
  @@index([hostId, dataScadenza])
  @@index([prenotazioneId])
  @@map("traces")
}

// ─── Accompagnatori (profili aggiuntivi per prenotazione) ─────────────────────

model Accompagnatore {
  id             String       @id @default(cuid())
  prenotazioneId String
  prenotazione   Prenotazione @relation(fields: [prenotazioneId], references: [id], onDelete: Cascade)

  // Anagrafica
  nome             String
  cognome          String
  sesso            String? // "M" o "F"
  dataNascita      DateTime? @db.Date
  luogoNascita     String?
  provinciaNascita String? // sigla 2 lettere
  nazionalita      String? // es. "Italiana", "Tedesca"

  // Documento (per Alloggiati Web)
  tipoDocumento     String? // PPORT, IDENTE, PATEN, ecc.
  numeroDocumento   String?
  luogoRilascio     String?
  provinciaRilascio String?

  // Codici ISTAT (per export Alloggiati Web)
  comuneNascitaIstat  String?
  statoNascitaIstat   String? @default("100000100")
  cittadinanzaIstat   String? @default("100000100")
  comuneRilascioIstat String?
  statoRilascioIstat  String?

  // Extra
  email    String?
  telefono String?
  note     String?
  isMinore Boolean @default(false) // < 18 anni

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([prenotazioneId])
  @@map("accompagnatori")
}

// ─── Registratore Telematico (scontrino fiscale RT) ──────────────────────────
//
// Obbligo di legge in Italia (D.Lgs. 127/2015 + Legge di Bilancio 2019): ogni
// esercizio di vendita al dettaglio deve usare un Registratore Telematico (RT)
// che emette scontrino fiscale e trasmette i corrispettivi all'Agenzia delle Entrate.
//
// Provider supportati (interfaccia pluggable in lib/registratore-rt.ts):
//   - NESSUNO: PMS non fiscale (es. b&b senza POS)
//   - MANUALE: l'operatore emette scontrino con stampante a parte, qui solo traccia
//   - EPSON_EPOS: Epson FP-90III / TM-m30II-F via ePos-Print XML (HTTP LAN)
//   - CUSTOM_KUBE: Custom KUBE F via XML HTTP
//   - OLIVETTI: Olivetti PRT 100F (protocollo proprietario)
//   - RCH: RCH Print!F / Wall!E

model RegistratoreRtConfig {
  hostId String @id
  host   Host   @relation(fields: [hostId], references: [id], onDelete: Cascade)

  provider         String  @default("NESSUNO") // NESSUNO | MANUALE | EPSON_EPOS | CUSTOM_KUBE | OLIVETTI | RCH
  matricola        String? // matricola RT (8-10 cifre, visibile sullo scontrino)
  endpointUrl      String? // IP locale o URL (es. http://192.168.1.50/cgi-bin/fpmate.cgi)
  timeout          Int     @default(10000) // ms
  aliquotaDefault  Float   @default(22) // IVA default per voci senza aliquota esplicita
  esercizioNumero  Int?    // numero esercizio (per sede con più punti vendita)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("registratore_rt_config")
}

// Record di ogni scontrino emesso (fiscale o non).
// Collegato a TransazionePOS esistente se generato da POS integrato.
model ScontrinoRT {
  id     String @id @default(cuid())
  hostId String
  host   Host   @relation(fields: [hostId], references: [id], onDelete: Cascade)

  // Riferimento transazione POS (opzionale)
  transazioneId String?

  // Dati fiscali RT
  numeroScontrino String // numero progressivo RT (giornaliero)
  matricolaRt     String?
  dataOra         DateTime @default(now())

  // Totali
  imponibile Float
  imposta    Float
  totale     Float
  metodoPagamento String @default("CARTA") // CARTA | CONTANTI | ELETTRONICO | MISTO

  // Righe (JSON per snapshot; breakdown per analytics separato in TransazionePOS.voci)
  righe Json // [{descrizione, qta, prezzo, aliquota, totale}]

  // Stato trasmissione AdE
  statoTrasmissione String    @default("LOCAL") // LOCAL | TRASMESSO | ERRORE
  erroreMessaggio   String?
  trasmessoAt       DateTime?

  // XML firmato (per audit)
  xmlOriginale String?

  createdAt DateTime @default(now())

  @@index([hostId, dataOra])
  @@index([transazioneId])
  @@map("scontrini_rt")
}

// ─── Pagamenti piattaforma (host → Otium per abbonamento) ────────────────────
//
// Tracciabilita` dei pagamenti ricevuti dall'host per l'abbonamento alla
// piattaforma. Distinto da `Pagamento` (che e` legato a fatture operative).
//
// Usi:
//   - registrazione manuale dall'admin
//   - integrazione Stripe (webhook payment_succeeded)
//   - bonifico tracciato con riferimento
//
// Il periodoInizio/periodoFine identifica il mese/periodo coperto.

model PagamentoPiattaforma {
  id     String @id @default(cuid())
  hostId String
  host   Host   @relation(fields: [hostId], references: [id], onDelete: Cascade)

  importo Float // EUR con 2 decimali (Prisma Decimal sarebbe meglio, Float ok per MVP)
  valuta  String @default("EUR")
  metodo  String @default("MANUALE") // MANUALE | STRIPE | BONIFICO | CARTA
  stato   String @default("PAGATO") // PAGATO | PENDENTE | FALLITO | RIMBORSATO

  riferimento String? // numero fattura host, ID transazione Stripe, CRO bonifico
  note        String?

  // Periodo coperto dal pagamento
  periodoInizio DateTime @db.Date
  periodoFine   DateTime @db.Date

  // Chi ha registrato (admin) o null per webhook automatici
  registratoDa String?

  createdAt DateTime @default(now())

  @@index([hostId])
  @@index([stato, createdAt])
  @@index([periodoInizio, periodoFine])
  @@map("pagamenti_piattaforma")
}

// ─── API Keys (per integrazioni 3rd-party) ───────────────────────────────────
//
// Chiave separata da NextAuth JWT per consentire integrazioni server-to-server.
// Il valore `token` e` lo SHA-256 hex di una chiave pseudo-random di 32 byte.
// All'atto della creazione viene mostrato UNA SOLA VOLTA.

model ApiKey {
  id     String @id @default(cuid())
  hostId String
  host   Host   @relation(fields: [hostId], references: [id], onDelete: Cascade)

  nome       String // label descrittiva ("Zapier integration", "App gestione contabile")
  token      String @unique // SHA-256 hex (64 char)
  prefix     String // primi 8 char della chiave (display-friendly per UI)
  scopes     String[] @default([]) // "prenotazioni:read", "prenotazioni:write", "ospiti:read", ecc.
  ultimaUsata DateTime?
  scadenza    DateTime?
  revocata    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([hostId])
  @@index([token])
  @@map("api_keys")
}

// ─── Export Alloggiati Web (PS / Questura) ───────────────────────────────────
//
// Log degli export eseguiti + file generato, per re-download e audit legale.

model ExportAlloggiati {
  id          String   @id @default(cuid())
  hostId      String
  host        Host     @relation(fields: [hostId], references: [id], onDelete: Cascade)
  strutturaId String
  struttura   Struttura @relation(fields: [strutturaId], references: [id], onDelete: Cascade)
  dataExport  DateTime @db.Date // giorno degli arrivi esportati

  numOspiti         Int
  numAccompagnatori Int
  numIncompleti     Int
  fileNome          String
  fileContenuto     String // contenuto del file (testo, qualche KB)

  esportatoDa String? // userId operatore
  createdAt   DateTime @default(now())

  @@index([hostId, dataExport])
  @@index([strutturaId, dataExport])
  @@map("export_alloggiati")
}

// ─── Chat ──────────────────────────────────────────────────────────────────────

model Chat {
  id             String       @id @default(cuid())
  prenotazioneId String       @unique
  prenotazione   Prenotazione @relation(fields: [prenotazioneId], references: [id], onDelete: Cascade)
  hostId         String
  host           Host         @relation(fields: [hostId], references: [id])

  messaggi  Messaggio[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@map("chat")
}

model Messaggio {
  id     String @id @default(cuid())
  chatId String
  chat   Chat   @relation(fields: [chatId], references: [id], onDelete: Cascade)

  mittente MessaggioMittente
  canale   CanaleMessaggio   @default(CHAT)
  testo    String
  letto    Boolean           @default(false)

  createdAt DateTime @default(now())

  // Indici per updateMany (segna letti) e ordinamento cronologico
  @@index([chatId])
  @@index([chatId, mittente, letto])
  @@map("messaggi")
}

// ─── Comunicazione Staff ──────────────────────────────────────────────────────

enum TipoComunicazione {
  AVVISO
  TASK
  NOTA
  URGENTE
}

model ComunicazioneStaff {
  id     String @id @default(cuid())
  hostId String
  host   Host   @relation(fields: [hostId], references: [id], onDelete: Cascade)

  tipo        TipoComunicazione @default(AVVISO)
  titolo      String
  testo       String?
  autore      String // nome di chi scrive (libero, non collegato a User)
  destinatari String[]          @default([]) // nomi destinatari oppure [] = tutti

  fissato    Boolean @default(false) // pin in cima
  archiviato Boolean @default(false)

  // Reazioni / letto da
  letti String[] @default([]) // nomi di chi ha confermato lettura

  dataScadenza DateTime? @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("comunicazioni_staff")
}

// ─── CRM Ospiti ───────────────────────────────────────────────────────────────

model OspiteCRM {
  id     String @id @default(cuid())
  hostId String
  host   Host   @relation(fields: [hostId], references: [id], onDelete: Cascade)

  // Anagrafica
  nome        String
  cognome     String
  email       String
  telefono    String?
  nazionalita String?
  lingua      String? @default("it")

  // Preferenze & CRM
  note            String?
  preferenze      String? // es. "piano alto, cuscino extra, allergia noci"
  vip             Boolean @default(false)
  blacklist       Boolean @default(false)
  blacklistMotivo String?

  // Tag liberi
  tags String[] @default([])

  // Statistiche (aggiornate automaticamente)
  numSoggiorni        Int       @default(0)
  totaleSpeso         Float     @default(0)
  dataUltimoSoggiorno DateTime?

  // Preferenze SPA
  spaAllergie              String? // es. "allergia oli essenziali, sensibile alle fragranze"
  spaNote                  String? // note per i terapisti
  spaPreferenzeTerapistaId String? // terapista preferito
  spaPreferenzeTerapista   TerapistaSpa? @relation("OspiteTerapistaPreferito", fields: [spaPreferenzeTerapistaId], references: [id])
  spaTrattamentiPreferiti  String[]      @default([]) // nomi/id trattamenti preferiti

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Collegamento prenotazioni via email (lookup dinamico)
  appuntamentiSpa AppuntamentoSpa[]
  conversazioniWA ConversazioneWhatsApp[]
  membriFedelta   MembroFedelta[]

  @@unique([hostId, email])
  @@map("ospiti_crm")
}

// ─── Manutenzione ─────────────────────────────────────────────────────────────

enum StatoManutenzione {
  APERTA
  IN_LAVORAZIONE
  IN_ATTESA_PARTI
  RISOLTA
  ANNULLATA
}

enum PrioritaManutenzione {
  BASSA
  NORMALE
  ALTA
  URGENTE
}

model SegnalazioneManutenzione {
  id          String            @id @default(cuid())
  hostId      String
  host        Host              @relation(fields: [hostId], references: [id], onDelete: Cascade)
  strutturaId String?
  struttura   Struttura?        @relation(fields: [strutturaId], references: [id])
  unitaId     String?
  unita       UnitaPrenotabile? @relation(fields: [unitaId], references: [id])

  titolo      String
  descrizione String?
  categoria   String // "IDRAULICA", "ELETTRICA", "SERRATURA", "ARREDO", "PULIZIA_STRAORD", "ALTRO"
  stato       StatoManutenzione    @default(APERTA)
  priorita    PrioritaManutenzione @default(NORMALE)

  assegnatoA   String? // nome tecnico/fornitore
  costoStimato Float?
  costoReale   Float?
  note         String?

  dataScadenza    DateTime? @db.Date
  dataRisoluzione DateTime?

  // Foto: `immagineUrl` è legacy (singola). `immagini` è canonica (multi, max 4 lato UI).
  // Durante la migrazione entrambi sono letti; scritture nuove usano `immagini`.
  immagineUrl String?
  immagini    String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("segnalazioni_manutenzione")
}

// ─── Housekeeping ─────────────────────────────────────────────────────────────

model TaskHK {
  id      String           @id @default(cuid())
  unitaId String
  unita   UnitaPrenotabile @relation(fields: [unitaId], references: [id], onDelete: Cascade)
  hostId  String

  tipo         String // "PULIZIA", "CAMBIO_BIANCHERIA", "MANUTENZIONE", "ALTRO"
  descrizione  String?
  priorita     PrioritaHK @default(NORMALE)
  assegnatoA   String? // nome operatore HK
  completato   Boolean    @default(false)
  completatoAt DateTime?
  note         String?

  dataScadenza DateTime? @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("task_hk")
}

// ─── Pacchetti evento + soggiorno ─────────────────────────────────────────

model Pacchetto {
  id          String    @id @default(cuid())
  hostId      String
  host        Host      @relation(fields: [hostId], references: [id], onDelete: Cascade)
  strutturaId String
  struttura   Struttura @relation(fields: [strutturaId], references: [id], onDelete: Cascade)

  nome        String // es. "Weekend Sagra del Tartufo"
  descrizione String?
  immagine    String?

  // Evento collegato — stringa libera (nome o URL). Dopo la rimozione del
  // modulo Eventi interno (2026-04), non esiste più collegamento a Evento.
  eventoEsterno String?

  // Dettagli pacchetto
  notti           Int    @default(1)
  numOspiti       Int    @default(2)
  prezzo          Float // prezzo pacchetto tutto incluso
  prezzoOriginale Float? // prezzo senza sconto (per mostrare risparmio)

  // Incluso nel pacchetto (testo libero, visualizzato come bullet list)
  incluso String[] @default([]) // es. ["2 notti in camera doppia", "Ingresso sagra", "Colazione"]

  attivo     Boolean   @default(true)
  dataInizio DateTime? @db.Date // periodo validità
  dataFine   DateTime? @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("pacchetti")
}

// ─── Notifiche ────────────────────────────────────────────────────────────────

model Notifica {
  id     String @id @default(cuid())
  hostId String
  host   Host   @relation(fields: [hostId], references: [id], onDelete: Cascade)

  tipo      String // "prenotazione", "checkin", "manutenzione", "sistema"
  titolo    String
  messaggio String?
  letta     Boolean @default(false)
  linkUrl   String? // es. "/host/prenotazioni/abc123"

  createdAt DateTime @default(now())

  @@map("notifiche")
}

// ─── Notifiche SUPERADMIN (platform-level events) ────────────────────────────
//
// Separata da `Notifica` perche` quella e` host-scoped (hostId non-nullable).
//   - userId = null  → broadcast a tutti i SUPERADMIN
//   - userId = <id>  → notifica indirizzata
model NotificaSuperadmin {
  id     String  @id @default(cuid())
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tipo      String // "ticket.nuovo" | "ticket.urgente" | "host.signup" | "email.fallita" | ...
  titolo    String
  messaggio String?
  linkUrl   String?
  priorita  String @default("NORMALE") // BASSA | NORMALE | ALTA | URGENTE

  entitaTipo String?
  entitaId   String?

  letta   Boolean   @default(false)
  lettaAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId, letta])
  @@index([tipo, createdAt])
  @@index([entitaTipo, entitaId])
  @@map("notifiche_superadmin")
}

// ─── Config Destinatari Notifiche SUPERADMIN ─────────────────────────────────
//
// Lista esplicita di chi riceve notifiche ticket/segnalazioni (supera il default
// "tutti i role=SUPERADMIN"). Supporta anche email esterne.
// Se la tabella e` vuota → fallback: notifica tutti i SUPERADMIN.
model ConfigNotificaDestinatario {
  id String @id @default(cuid())

  // Almeno uno tra userId e emailEsterna deve essere valorizzato
  userId       String?
  user         User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailEsterna String?

  nome String? // label ("Capo IT", "On-call", "info@agency.com")

  tipiEvento     String[] @default([]) // filtri ["ticket.nuovo"...]; vuoto = tutti
  prioritaMinima String   @default("BASSA") // BASSA | NORMALE | ALTA | URGENTE
  canali         String[] @default(["email", "inapp"]) // email | inapp | slack

  attivo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([attivo])
  @@index([userId])
  @@map("config_notifica_destinatari")
}

// ─── Config Email automatiche ────────────────────────────────────────────────
//
// Personalizzazioni host dei template email definiti in lib/email-templates.ts.
// Un record per (hostId, templateId). Se assente: template attivo con default.

model ConfigEmail {
  id     String @id @default(cuid())
  hostId String
  host   Host   @relation(fields: [hostId], references: [id], onDelete: Cascade)

  templateId      String // "conferma_prenotazione", "pre_checkin", ecc.
  attiva          Boolean @default(true)
  oggettoCustom   String?
  messaggioCustom String? // HTML safe, aggiunto in coda al body del template standard
  ritardoOre      Int? // override del ritardo default del template (in ore)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([hostId, templateId])
  @@index([hostId])
  @@map("config_email")
}

// ─── Audit Log ────────────────────────────────────────────────────────────────

model AuditLog {
  id        String  @id @default(cuid())
  hostId    String?
  userId    String? // chi ha eseguito l'azione
  userEmail String?

  azione    String // "prenotazione.creata", "checkin.completato", "fattura.emessa", ecc.
  entita    String // "prenotazione", "fattura", "struttura", "ospite", ecc.
  entitaId  String? // ID dell'entità coinvolta
  dettagli  String? // descrizione leggibile
  datiJson  Json? // payload completo (old/new values)
  ip        String? // IP del client
  userAgent String?

  createdAt DateTime @default(now())

  @@index([hostId, createdAt])
  @@index([entita, entitaId])
  @@map("audit_log")
}

// ─── Consent Tracking (Art. 7 GDPR) ────────────────────────────────────────────

/// Storico immutabile dei consensi (Art. 7 GDPR).
/// Ogni cambio di stato (accetta → revoca) è un NUOVO record, non un UPDATE.
/// Il consenso "attivo" è l'ultimo record per (subject, hostId, tipo) con revocatoAt=null.
model UserConsent {
  id         String @id @default(cuid())

  // ─── Chi ──────────────────────────────────────────────────────────────────
  hostId     String? // host di riferimento (multi-tenant)
  userId     String? // utente autenticato (staff/host)
  guestEmail String? // ospite non autenticato
  guestToken String? // token HMAC per identificare l'ospite senza login

  // ─── Cosa ─────────────────────────────────────────────────────────────────
  // tipo: "termini_servizio" | "privacy_ospite" | "marketing_email" | "marketing_sms"
  //       | "spa_art9" | "cookie_analytics" | "cookie_marketing" | "profilazione_crm"
  tipo       String
  versione   String // es. "2026-04-01". Se il testo del documento cambia, serve nuovo consenso.

  // ─── Stato ────────────────────────────────────────────────────────────────
  accettato  Boolean @default(true) // true = dato, false = revocato

  // ─── Prova del consenso (Art. 7.1 GDPR: onere della prova) ───────────────
  ip         String?
  userAgent  String?
  metodo     String? @default("checkbox") // "checkbox" | "firma_digitale" | "double_opt_in" | "api"

  // ─── Revoca ───────────────────────────────────────────────────────────────
  revocatoAt    DateTime?
  revocaMotivo  String? // "richiesta_ospite" | "scadenza" | "cambio_versione"

  createdAt  DateTime @default(now())

  @@index([guestEmail, tipo])
  @@index([hostId, tipo])
  @@index([guestToken])
  @@index([userId])
  @@index([tipo, createdAt])
  @@map("user_consents")
}

/// Richiesta di cancellazione dati da parte dell'ospite (Art. 17 GDPR — diritto
/// all'oblio). L'host ha 30 giorni per eseguirla o motivare il rifiuto.
/// I dati sotto obbligo legale (fatture 10 anni, Alloggiati 5 anni) non sono
/// cancellabili e l'host deve documentarlo nel motivoRifiuto.
model RichiestaCancellazione {
  id         String @id @default(cuid())
  hostId     String
  host       Host   @relation(fields: [hostId], references: [id], onDelete: Cascade)
  guestEmail String
  guestNome  String

  motivo String?

  // PENDENTE | IN_LAVORAZIONE | COMPLETATA | RIFIUTATA
  stato         String  @default("PENDENTE")
  motivoRifiuto String? // obbligatorio se stato=RIFIUTATA

  // Report di cosa è stato cancellato/anonimizzato
  // Es: { prenotazioni: 3, waiverSpa: 2, crm: true, fatture: 0 (obbligo legale) }
  datiCancellati Json?

  // Timeline
  richiestaAt  DateTime  @default(now())
  scadenzaAt   DateTime // richiestaAt + 30 giorni (Art. 17)
  completataAt DateTime?
  completataDa String? // userId operatore

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([hostId, stato])
  @@index([guestEmail])
  @@index([scadenzaAt])
  @@map("richieste_cancellazione")
}

/// Accettazione DPA (Data Processing Agreement) da parte dell'host (Art. 28 GDPR).
/// Ogni cambio versione del template DPA richiede una nuova accettazione.
/// La firma è digitale (canvas base64), con IP/userAgent come prova legale.
model DPAAccettazione {
  id     String @id @default(cuid())
  hostId String
  host   Host   @relation(fields: [hostId], references: [id], onDelete: Cascade)

  versione    String // es. "2026-04-01"
  firmaBase64 String? // PNG data URL canvas
  firmaNome   String // nome firmatario
  firmaRuolo  String? // "Titolare" | "Legale rappresentante" | "Amministratore"
  ip          String?
  userAgent   String?

  accettatoAt DateTime @default(now())

  @@index([hostId])
  @@index([versione])
  @@map("dpa_accettazioni")
}

// ─── SPA Module ────────────────────────────────────────────────────────────────

enum CategoriaSpa {
  MASSAGGIO
  VISO
  CORPO
  RITUALI
  BAGNI
  COPPIA
  ALTRO
}

enum StatoAppuntamentoSpa {
  PRENOTATO
  CONFERMATO
  IN_CORSO
  COMPLETATO
  ANNULLATO
  NO_SHOW
}

enum TipoDisponibilita {
  SETTIMANALE // fascia oraria ricorrente ogni settimana
  SPECIFICA // giorno specifico
  BLOCCO // blocco: ferie, indisponibilità
}

enum MetodoPagamentoSpa {
  CAMERA_CREDIT // addebito su camera della prenotazione
  CONTANTI
  CARTA
  TRANSFERWISE
  GIFT_CARD
}

enum StatoPagamentoSpa {
  PENDENTE
  RISCOSSO
  RIMBORSO_RICHIESTO
  RIMBORSATO
}

model TerapistaSpa {
  id     String @id @default(cuid())
  hostId String
  host   Host   @relation(fields: [hostId], references: [id], onDelete: Cascade)

  nome             String
  cognome          String
  email            String?
  telefono         String?
  colore           String   @default("#6366f1") // colore nel calendario
  specializzazioni String[] @default([]) // es. ["massaggio", "estetica"]
  note             String?
  attivo           Boolean  @default(true)

  // Profilo pubblico
  profiloPublico Boolean @default(false)
  bio            String?

  createdAt        DateTime                 @default(now())
  appuntamenti     AppuntamentoSpa[]
  disponibilita    DisponibilitaTerapista[]
  ospitePreferenza OspiteCRM[]              @relation("OspiteTerapistaPreferito")
  waitingList      WaitingListSpa[]

  @@map("terapisti_spa")
}

model CabinaSpa {
  id     String @id @default(cuid())
  hostId String
  host   Host   @relation(fields: [hostId], references: [id], onDelete: Cascade)

  nome        String // es. "Cabina 1", "Suite Relax", "Grotta del sale"
  descrizione String?
  colore      String  @default("#8b5cf6")
  capacita    Int     @default(1) // n. persone simultanee
  attiva      Boolean @default(true)

  // Display tablet
  fotoSfondo          String?   // URL immagine sfondo per tablet cabina
  minutiPreAttivazione Int      @default(10) // minuti prima dell'appuntamento per attivare il display

  // Housekeeping cabina SPA
  statoHK             String    @default("PULITA") // PULITA, OCCUPATA, IN_PULIZIA, NON_DISPONIBILE
  ultimaPulizia       DateTime?
  durataPuliziaMinuti Int       @default(15) // turnaround tra appuntamenti
  noteHK              String?

  // Dotazione configurabile per cabina
  dotazione DotazioneCabinaSpa[]

  createdAt    DateTime          @default(now())
  appuntamenti AppuntamentoSpa[]

  @@map("cabine_spa")
}

// Dotazione articoli per cabina SPA — completamente configurabile dall'host
model DotazioneCabinaSpa {
  id       String    @id @default(cuid())
  cabinaId String
  cabina   CabinaSpa @relation(fields: [cabinaId], references: [id], onDelete: Cascade)

  articolo  String // nome libero: "Asciugamano grande", "Olio lavanda", "Cuffia monouso", ecc.
  quantita  Int    @default(1) // pezzi per appuntamento
  categoria String @default("BIANCHERIA") // BIANCHERIA, PRODOTTI, MONOUSO, ATTREZZATURA, ALTRO

  createdAt DateTime @default(now())

  @@index([cabinaId])
  @@map("dotazione_cabina_spa")
}

model TrattamentoSpa {
  id     String @id @default(cuid())
  hostId String
  host   Host   @relation(fields: [hostId], references: [id], onDelete: Cascade)

  nome              String // es. "Massaggio svedese 50 min"
  categoria         CategoriaSpa @default(MASSAGGIO)
  durata            Int // minuti
  prezzo            Float
  descrizione       String?
  colore            String       @default("#06b6d4")
  attivo            Boolean      @default(true)
  prenotabileOnline Boolean      @default(false) // visibile e prenotabile sul booking engine pubblico

  createdAt    DateTime            @default(now())
  appuntamenti AppuntamentoSpa[]
  passaggi     PassaggioPercorso[]
  giftCards    GiftCard[]
  waitingList  WaitingListSpa[]
  turnaway     TurnawayTracking[]
  VocePOS      VocePOS[]

  @@map("trattamenti_spa")
}

model PercorsoBenessere {
  id     String @id @default(cuid())
  hostId String
  host   Host   @relation(fields: [hostId], references: [id], onDelete: Cascade)

  nome         String // es. "Weekend della Coppia", "Percorso Detox"
  descrizione  String?
  prezzo       Float
  durataMinuti Int     @default(0) // calcolata automaticamente dalla somma dei passaggi
  attivo       Boolean @default(true)
  colore       String  @default("#f59e0b")

  createdAt    DateTime            @default(now())
  passaggi     PassaggioPercorso[]
  appuntamenti AppuntamentoSpa[]

  @@map("percorsi_benessere")
}

model PassaggioPercorso {
  id            String            @id @default(cuid())
  percorsoId    String
  percorso      PercorsoBenessere @relation(fields: [percorsoId], references: [id], onDelete: Cascade)
  trattamentoId String
  trattamento   TrattamentoSpa    @relation(fields: [trattamentoId], references: [id], onDelete: Cascade)

  ordine Int     @default(0)
  durata Int // minuti (può sovrascrivere quella del trattamento)
  note   String?

  @@map("passaggi_percorso")
}

model AppuntamentoSpa {
  id     String @id @default(cuid())
  hostId String
  host   Host   @relation(fields: [hostId], references: [id], onDelete: Cascade)

  // Ospite
  guestNome      String
  guestCognome   String?
  guestEmail     String?
  guestTelefono  String?
  ospiteId       String? // link opzionale a OspiteCRM
  ospite         OspiteCRM?    @relation(fields: [ospiteId], references: [id])
  prenotazioneId String? // link opzionale a prenotazione soggiorno
  prenotazione   Prenotazione? @relation(fields: [prenotazioneId], references: [id])

  // Risorse
  cabinaId    String?
  cabina      CabinaSpa?    @relation(fields: [cabinaId], references: [id])
  terapistaId String?
  terapista   TerapistaSpa? @relation(fields: [terapistaId], references: [id])

  // Servizio
  trattamentoId String?
  trattamento   TrattamentoSpa?    @relation(fields: [trattamentoId], references: [id])
  percorsoId    String?
  percorso      PercorsoBenessere? @relation(fields: [percorsoId], references: [id])

  // Slot temporale
  dataOra DateTime // inizio appuntamento
  durata  Int // minuti

  // Prezzo e stato
  prezzoTotale       Float?
  stato              StatoAppuntamentoSpa @default(CONFERMATO)
  note               String?
  reminderInviato    Boolean              @default(false) // reminder giorno prima
  waiverObbligatorio Boolean              @default(true)
  checkInSpa         Boolean              @default(false) // ospite arrivato alla SPA

  // Relazioni waiver e pagamento
  waiver            WaiverSpa?
  pagamento         PagamentoSpa?
  movimentiGiftCard GiftCardMovimento[]
  movimentiPunti    MovimentoPunti[]
  transazioniPOS    TransazionePOS[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([hostId, dataOra]) // calendario SPA + availability check
  @@index([hostId, stato]) // dashboard conteggi SPA
  @@index([terapistaId, dataOra]) // conflict detection terapista
  @@index([cabinaId, dataOra]) // conflict detection cabina
  @@index([prenotazioneId]) // lookup appuntamenti di una prenotazione
  @@map("appuntamenti_spa")
}

model DisponibilitaTerapista {
  id          String       @id @default(cuid())
  hostId      String
  host        Host         @relation(fields: [hostId], references: [id], onDelete: Cascade)
  terapistaId String
  terapista   TerapistaSpa @relation(fields: [terapistaId], references: [id], onDelete: Cascade)

  tipo         TipoDisponibilita @default(SETTIMANALE)
  giorno       Int? // 0=lun..6=dom, solo per SETTIMANALE
  data         DateTime? // data esatta, solo per SPECIFICA o BLOCCO
  orarioInizio String // "09:00"
  orarioFine   String // "18:00"
  attiva       Boolean           @default(true)

  createdAt DateTime @default(now())

  @@map("disponibilita_terapisti")
}

// ─── SPA Waiver & Payments ────────────────────────────────────────────────────────

model WaiverSpa {
  id             String          @id @default(cuid())
  appuntamentoId String          @unique
  appuntamento   AppuntamentoSpa @relation(fields: [appuntamentoId], references: [id], onDelete: Cascade)

  // Firma digitale
  firmaBase64       String? // Canvas drawing base64
  dataRegistrazione DateTime @default(now())

  // Zone del corpo (semplici checkbox, no SVG)
  zoneTrattate String[] @default([])
  zoneEvitare  String[] @default([])

  // ─── Condizioni di salute (checkbox guidate) ───────────────────
  incinta         Boolean  @default(false)
  incintaMesi     Int?
  condizioni      String[] @default([]) // ["pressione_alta", "diabete", "epilessia", ...]
  condizioneAltro String? // testo libero se seleziona "altro"

  // Allergie (checkbox + testo)
  allergieSelezionate String[] @default([]) // ["lattice", "oli_essenziali", "profumi", "nichel"]
  allergieAltro       String? // testo libero se seleziona "altro"

  // Campi legacy (mantenuti per retrocompatibilità con waiver esistenti)
  allergie  String?
  patologie String?
  farmaci   String?

  // ─── Preferenze trattamento ────────────────────────────────────
  pressioneMassaggio   String? // "leggera" | "media" | "forte"
  temperaturaPreferita String? // "freddo" | "tiepido" | "caldo"
  musicaPreferita      String? // "si" | "no" | "indifferente"
  aromiPreferiti       String? // "si" | "senza"
  notePreferenze       String? // note libere preferenze

  // Accettazione T&C
  accettazioneTermini  Boolean @default(false)
  accettazionePrivacy  Boolean @default(false)
  consensoFoto         Boolean @default(false)
  dichiarazioneNessuna Boolean @default(false) // "Dichiaro di non avere condizioni mediche rilevanti"
  consensoArt9At       DateTime? // timestamp esplicito consenso trattamento dati sanitari Art. 9 GDPR

  // Status firma
  confermato        Boolean   @default(false)
  dataConfermaPaper DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("waivers_spa")
}

model PagamentoSpa {
  id             String          @id @default(cuid())
  appuntamentoId String          @unique
  appuntamento   AppuntamentoSpa @relation(fields: [appuntamentoId], references: [id], onDelete: Cascade)

  // Importo
  importo     Float
  tipoImporto String @default("TRATTAMENTO") // TRATTAMENTO|PERCORSO|PERSONALIZZATO

  // Metodo pagamento
  metodo MetodoPagamentoSpa @default(CONTANTI)

  // Se camera credit
  unitaId String?
  unita   UnitaPrenotabile? @relation(fields: [unitaId], references: [id], onDelete: SetNull)

  // Se carta
  ultimeQuatroCifre String? // 4242

  // Stato
  stato           StatoPagamentoSpa @default(PENDENTE)
  dataRiscossione DateTime?
  noteRiscossione String? // ref number, check number, etc.

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([appuntamentoId])
  @@index([unitaId])
  @@map("pagamenti_spa")
}

// ─── AI Concierge WhatsApp ────────────────────────────────────────────────────

enum StatoConversazioneWA {
  ATTIVA // gestita dall'AI
  ESCALATA // passata a operatore umano
  CHIUSA // conclusa
}

enum MittenteWA {
  OSPITE
  AI_CONCIERGE
  HOST_UMANO // quando l'host interviene manualmente
}

enum TipoAzioneConcierge {
  SPA_CHECK_DISPONIBILITA
  SPA_PRENOTAZIONE
  HK_TASK_CREATO
  MANUTENZIONE_SEGNALATA
  LATE_CHECKOUT_RICHIESTO
  INFO_FORNITA
  ESCALATION
}

model ConversazioneWhatsApp {
  id     String @id @default(cuid())
  hostId String
  host   Host   @relation(fields: [hostId], references: [id], onDelete: Cascade)

  // Identificazione ospite
  telefonoOspite String // numero WhatsApp (formato E.164: +393331234567)
  nomeOspite     String? // nome se identificato
  prenotazioneId String? // prenotazione collegata (se trovata)
  prenotazione   Prenotazione? @relation(fields: [prenotazioneId], references: [id])
  ospiteCrmId    String? // collegamento CRM
  ospiteCrm      OspiteCRM?    @relation(fields: [ospiteCrmId], references: [id])

  stato  StatoConversazioneWA @default(ATTIVA)
  lingua String               @default("it") // lingua rilevata dall'AI

  messaggi MessaggioWhatsApp[]
  azioni   AzioneConcierge[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([hostId, telefonoOspite]) // una conversazione per ospite per host
  @@index([hostId, stato])
  @@map("conversazioni_whatsapp")
}

model MessaggioWhatsApp {
  id              String                @id @default(cuid())
  conversazioneId String
  conversazione   ConversazioneWhatsApp @relation(fields: [conversazioneId], references: [id], onDelete: Cascade)

  mittente          MittenteWA
  testo             String
  whatsappMessageId String? // ID messaggio da Meta API (delivery tracking)

  // Metadata AI
  toolsUsati  String[] @default([]) // nomi tool chiamati nella risposta
  tokensUsati Int? // token consumati per risposta AI

  createdAt DateTime @default(now())

  @@index([conversazioneId])
  @@map("messaggi_whatsapp")
}

model AzioneConcierge {
  id              String                @id @default(cuid())
  conversazioneId String
  conversazione   ConversazioneWhatsApp @relation(fields: [conversazioneId], references: [id], onDelete: Cascade)

  tipo        TipoAzioneConcierge
  descrizione String // "Prenotato massaggio 60min ore 15:00"
  datiJson    Json? // payload completo azione (ID task creato, slot prenotato, ecc.)
  successo    Boolean             @default(true)
  errore      String? // se fallita, motivo

  createdAt DateTime @default(now())

  @@index([conversazioneId])
  @@map("azioni_concierge")
}

// ─── Ticket Support ───────────────────────────────────────────────────────────

enum CategoriaTicket {
  BUG
  FEATURE_REQUEST
  DOMANDA
  PROBLEMA_ACCOUNT
  ALTRO
}

enum PrioritaTicket {
  BASSA
  NORMALE
  ALTA
  URGENTE
}

enum StatoTicket {
  APERTO
  IN_LAVORAZIONE
  IN_ATTESA_RISPOSTA
  RISOLTO
  CHIUSO
}

model Ticket {
  id            String          @id @default(cuid())
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  hostId        String?
  host          Host?           @relation(fields: [hostId], references: [id], onDelete: SetNull)
  oggetto       String
  descrizione   String
  categoria     CategoriaTicket @default(BUG)
  priorita      PrioritaTicket  @default(NORMALE)
  stato         StatoTicket     @default(APERTO)
  paginaUrl     String?
  userAgent     String?
  screenshot    String?
  /// Legacy — risposta singola admin. Per thread conversazione usare `risposte`.
  rispostaAdmin String?
  rispostoDa    String?
  rispostoAt    DateTime?
  /// Assegnato a admin user id (ownership supporto)
  assegnatoA    String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  /// Thread risposte conversazione (host ↔ admin)
  risposte      TicketRisposta[]

  @@index([userId])
  @@index([hostId])
  @@index([stato])
  @@index([assegnatoA, stato])
  @@map("tickets")
}

/// Risposta a un ticket — parte di un thread conversazione host ↔ admin.
model TicketRisposta {
  id       String @id @default(cuid())
  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  autoreId    String
  autoreEmail String
  /// 'host' | 'admin'
  autoreRuolo String

  testo    String
  allegati Json? // [{ nome, url }]

  createdAt DateTime @default(now())

  @@index([ticketId])
  @@index([ticketId, createdAt])
  @@map("ticket_risposte")
}

