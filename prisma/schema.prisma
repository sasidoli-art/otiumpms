model TurnawayTracking {
  id     String @id @default(cuid())
  hostId String
  host   Host   @relation(fields: [hostId], references: [id], onDelete: Cascade)

  // Ospite (anonimo se non identificato)
  guestNome  String?
  guestEmail String?

  // Cosa voleva
  trattamentoId   String?
  trattamento     TrattamentoSpa? @relation(fields: [trattamentoId], references: [id])
  data            DateTime        @db.Date
  orarioRichiesto String?

  motivo MotivoTurnaway @default(PIENO)
  note   String?

  // Revenue persa stimata
  ricavoPerso Float?

  createdAt DateTime @default(now())

  @@index([hostId, createdAt])
  @@index([trattamentoId])
  @@map("turnaway_tracking")
}

// ─── Cassa & Chiusura Giornaliera ─────────────────────────────────────────────

enum OrigineIncasso {
  PRENOTAZIONE
  SPA
  RISTORAZIONE
  POS
  GIFT_CARD
  ALTRO
}

model ChiusuraCassa {
  id                  String   @id @default(cuid())
  hostId              String
  host                Host     @relation(fields: [hostId], references: [id], onDelete: Cascade)
  data                DateTime
  operatore           String
  turno               String?
  totaleContanti      Float    @default(0)
  totaleCarta         Float    @default(0)
  totaleBonifico      Float    @default(0)
  totaleGiftCard      Float    @default(0)
  totaleCamera        Float    @default(0)
  totaleComplessivo   Float    @default(0)
  totaleVisa          Float    @default(0)
  totaleMastercard    Float    @default(0)
  totaleAmex          Float    @default(0)
  totaleBancomat      Float    @default(0)
  totaleAltreCard     Float    @default(0)
  numTransazioni      Int      @default(0)
  numVendite          Int      @default(0)
  numResi             Int      @default(0)
  numSconti           Int      @default(0)
  fondoCassaInizio    Float?
  fondoCassaFine      Float?
  differenza          Float?
  riconciliato        Boolean  @default(false)
  noteRiconciliazione String?
  chiusoAt            DateTime @default(now())

  incassi Incasso[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([hostId, data])
  @@index([hostId, data])
  @@map("chiusure_cassa")
}

model Incasso {
  id              String             @id @default(cuid())
  hostId          String
  host            Host               @relation(fields: [hostId], references: [id], onDelete: Cascade)
  data            DateTime           @default(now())
  importo         Float
  metodo          MetodoPagamentoPOS
  tipoCarta       TipoCarta?
  ultime4Cifre    String?
  riferimento     String?
  origine         OrigineIncasso
  prenotazioneId  String?
  prenotazione    Prenotazione?      @relation(fields: [prenotazioneId], references: [id])
  transazioneId   String?
  appuntamentoId  String?
  operatore       String
  descrizione     String
  note            String?
  chiusuraCassaId String?
  chiusura        ChiusuraCassa?     @relation(fields: [chiusuraCassaId], references: [id])
  riconciliato    Boolean            @default(false)
  createdAt       DateTime           @default(now())

  @@index([hostId, data])
  @@index([hostId, metodo])
  @@index([hostId, riconciliato])
  @@index([chiusuraCassaId])
  @@map("incassi")
}

// ─── Contratti & Allotment ───────────────────────────────────────────────────

enum TipoContratto {
  TOUR_OPERATOR
  AGENZIA
  CORPORATE
  GRUPPO
}

enum StatoContratto {
  ATTIVO
  SCADUTO
  SOSPESO
}

model ContrattoAllotment {
  id     String @id @default(cuid())
  hostId String
  host   Host   @relation(fields: [hostId], references: [id], onDelete: Cascade)

  tipo          TipoContratto
  nomePartner   String
  contatto      String?
  email         String?
  telefono      String?
  dataInizio    DateTime @db.Date
  dataFine      DateTime @db.Date
  stato         StatoContratto @default(ATTIVO)

  // Allotment
  strutturaId          String
  struttura            Struttura @relation(fields: [strutturaId], references: [id])
  unitaRiservate       Int
  unitaVendute         Int       @default(0)
  tariffaNegoziata     Float?
  scontoPercentuale    Float?
  commissionePercentuale Float?

  // Policy
  releaseGiorni         Int     @default(7)
  cancellazioneGratuita Boolean @default(true)

  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([hostId, stato])
  @@map("contratti_allotment")
}

// ─── Modulo Wi-Fi ─────────────────────────────────────────────────────────────

enum WifiDeviceStato {
  PENDING      // registrato ma mai visto online
  ONLINE       // heartbeat recente
  OFFLINE      // nessun heartbeat > soglia
  DISABLED     // disattivato manualmente
}

enum WifiCommandStato {
  PENDING
  SENT
  DONE
  FAILED
  EXPIRED
}

enum WifiGuestStato {
  ATTIVO
  SCADUTO
  REVOCATO
}

model WifiDevice {
  id          String @id @default(cuid())
  hostId      String
  host        Host   @relation(fields: [hostId], references: [id], onDelete: Cascade)
  strutturaId String?
  struttura   Struttura? @relation(fields: [strutturaId], references: [id], onDelete: SetNull)

  alias       String              // nome leggibile (es. "Reception ground floor")
  mac         String  @unique     // MAC controller Comfast (identificativo univoco)
  modello     String?             // es. "CF-AC300", "CF-AC100"
  firmware    String?             // versione OrangeOS rilevata
  apiTokenHash String             // hash del bearer token dell'agent (mai plaintext)
  stato       WifiDeviceStato @default(PENDING)

  // Ultimo heartbeat
  ultimoHeartbeatAt DateTime?
  ultimoIpPubblico  String?
  ultimoAgentVersion String?

  // Config splash (fonte di verità dal PMS, propagata al device)
  splashConfig Json?  // { titolo, messaggio, testoBottone, linkRedirect, slideshowUrls[], logoUrl }

  // Policy utenti guest di default
  defaultUserDurationMin Int @default(1440) // 24h
  defaultUserBandwidthKbps Int? // null = illimitato

  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  commands    WifiDeviceCommand[]
  guestUsers  WifiGuestUser[]
  accessLogs  WifiAccessLog[]

  @@index([hostId, stato])
  @@index([strutturaId])
  @@map("wifi_devices")
}

model WifiDeviceCommand {
  id         String @id @default(cuid())
  deviceId   String
  device     WifiDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  action     String            // es. "set_splash_branding", "add_guest_user", "upload_splash_image"
  payload    Json              // parametri azione
  stato      WifiCommandStato @default(PENDING)

  // Lifecycle
  sentAt     DateTime?         // quando l'agent l'ha ritirato
  doneAt     DateTime?         // quando l'agent ha riportato esito
  result     Json?             // output restituito dall'agent
  errorMsg   String?

  // Auto-scadenza: comandi non ritirati entro X ore diventano EXPIRED
  expiresAt  DateTime?

  // Chi l'ha creato (operatore host)
  createdByUserId String?

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([deviceId, stato])
  @@index([stato, expiresAt])
  @@map("wifi_device_commands")
}

model WifiGuestUser {
  id         String @id @default(cuid())
  hostId     String
  host       Host   @relation(fields: [hostId], references: [id], onDelete: Cascade)
  deviceId   String
  device     WifiDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  // Dati account portale
  username   String
  passwordHash String            // hash, mai plaintext
  displayName String?            // nome mostrato all'ospite
  note       String?

  // Collegamento opzionale a prenotazione / ospite del PMS
  prenotazioneId String?
  ospiteCrmId    String?

  stato      WifiGuestStato @default(ATTIVO)
  validFrom  DateTime @default(now())
  validUntil DateTime?

  // Telemetria dall'agent
  ultimoLoginAt DateTime?
  ultimoMac     String?
  byteScaricati BigInt @default(0)
  byteCaricati  BigInt @default(0)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([deviceId, username])
  @@index([hostId, stato])
  @@index([prenotazioneId])
  @@map("wifi_guest_users")
}

model WifiAccessLog {
  id         String @id @default(cuid())
  hostId     String
  host       Host   @relation(fields: [hostId], references: [id], onDelete: Cascade)
  deviceId   String
  device     WifiDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  timestamp  DateTime
  eventType  String    // "login", "logout", "timeout", "revoke"
  username   String?
  macClient  String?
  ipClient   String?
  bytesIn    BigInt?
  bytesOut   BigInt?
  sessionSec Int?

  createdAt  DateTime @default(now())

  @@index([deviceId, timestamp])
  @@index([hostId, timestamp])
  @@map("wifi_access_logs")
}

// ─── Wi-Fi Access Codes (walk-in) ────────────────────────────────────────────
// Codici operatore per ospiti walk-in: durata, max usi, scadenza assoluta.
// Indipendenti dal device: valgono per l'host. Quando il device Comfast esiste,
// il sistema crea automaticamente lo user corrispondente al primo login.

model WifiAccessCode {
  id          String   @id @default(cuid())
  hostId      String
  host        Host     @relation(fields: [hostId], references: [id], onDelete: Cascade)

  codice         String   @unique  // 8 char alphanum, case-insensitive in check
  durataMinuti   Int               // validita' sessione dopo il login (es. 1440 = 24h)
  usiMax         Int               // max login totali (-1 = illimitato)
  usiEffettuati  Int      @default(0)
  validoFino     DateTime          // dopo questa data il codice e' spento

  note           String?
  createdByUserId String?
  revocatoAt     DateTime?

  sessioni       WifiSession[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([hostId, revocatoAt])
  @@index([validoFino])
  @@map("wifi_access_codes")
}

// ─── Wi-Fi Sessions ──────────────────────────────────────────────────────────
// Una sessione autenticata (compliance Pisanu: log 6 mesi, identificativo ospite).

enum WifiSessionTipo {
  PRENOTAZIONE   // ospite in struttura, login con nome+camera
  CODICE         // walk-in, login con codice di accesso
  COMPLIMENTARY  // accesso gratuito a tempo, nessuna auth richiesta
  USER_FORM      // registrazione con nome+email (lead generation)
  EMAIL_ONLY     // match prenotazione via sola email (opt-in per host)
}

model WifiSession {
  id              String   @id @default(cuid())
  hostId          String
  host            Host     @relation(fields: [hostId], references: [id], onDelete: Cascade)

  tipo            WifiSessionTipo
  prenotazioneId  String?
  accessCodeId    String?
  accessCode      WifiAccessCode? @relation(fields: [accessCodeId], references: [id], onDelete: SetNull)

  // Identita' ospite (denormalizzata per audit log)
  guestNome       String
  guestCognome    String?
  numeroCamera    String?         // solo per tipo=PRENOTAZIONE

  // Contesto tecnico (quando disponibile dal captive portal)
  macClient       String?
  ipClient        String?
  userAgent       String?

  // Lifecycle
  startAt         DateTime @default(now())
  expiresAt       DateTime
  revokedAt       DateTime?

  createdAt       DateTime @default(now())

  @@index([hostId, startAt])
  @@index([prenotazioneId])
  @@index([accessCodeId])
  @@map("wifi_sessions")
}
