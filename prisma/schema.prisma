// ─── Gift Card ────────────────────────────────────────────────────────────────

enum TipoGiftCard {
  IMPORTO // valore monetario libero
  TRATTAMENTO // singolo trattamento specifico
  PACCHETTO // pacchetto trattamenti
}

enum StatoGiftCard {
  ATTIVA
  UTILIZZATA
  SCADUTA
  ANNULLATA
}

enum TipoMovimentoGiftCard {
  EMISSIONE
  UTILIZZO
  RICARICA
  RIMBORSO
}

model GiftCard {
  id     String @id @default(cuid())
  hostId String
  host   Host   @relation(fields: [hostId], references: [id], onDelete: Cascade)

  codice String        @unique // codice univoco gift card (es. "GC-XXXX-YYYY")
  tipo   TipoGiftCard  @default(IMPORTO)
  stato  StatoGiftCard @default(ATTIVA)

  // Valore
  valoreOriginale Float // importo iniziale
  saldoResiduo    Float // saldo rimanente

  // Se tipo TRATTAMENTO
  trattamentoId String?
  trattamento   TrattamentoSpa? @relation(fields: [trattamentoId], references: [id])

  // Acquirente
  acquirenteNome     String
  acquirenteEmail    String
  acquirenteTelefono String?

  // Destinatario
  destinatarioNome  String?
  destinatarioEmail String?
  messaggio         String?

  // Validità
  dataEmissione DateTime  @default(now())
  dataScadenza  DateTime
  dataUtilizzo  DateTime?

  movimenti GiftCardMovimento[]

  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  TransazionePOS TransazionePOS[]

  @@index([hostId, stato])
  @@index([codice])
  @@map("gift_cards")
}

model GiftCardMovimento {
  id         String   @id @default(cuid())
  giftCardId String
  giftCard   GiftCard @relation(fields: [giftCardId], references: [id], onDelete: Cascade)

  tipo      TipoMovimentoGiftCard
  importo   Float // positivo per emissione/rimborso, negativo per utilizzo
  saldoDopo Float // saldo residuo dopo il movimento

  // Collegamento opzionale ad appuntamento
  appuntamentoId String?
  appuntamento   AppuntamentoSpa? @relation(fields: [appuntamentoId], references: [id])

  descrizione String
  operatore   String?
  note        String?

  createdAt DateTime @default(now())

  @@index([giftCardId])
  @@map("gift_card_movimenti")
}

// ─── POS (Point of Sale) ──────────────────────────────────────────────────────

enum TipoTransazionePOS {
  VENDITA
  RESO
  SCONTO
}

enum StatoTransazionePOS {
  COMPLETATA
  INVIATO
  ANNULLATA
  RIMBORSATA
}

enum MetodoPagamentoPOS {
  CONTANTI
  CARTA
  CAMERA_CREDIT
  GIFT_CARD
  BONIFICO
  MISTO
}

enum TipoCarta {
  VISA
  MASTERCARD
  AMEX
  BANCOMAT
  MAESTRO
  ALTRO
}

enum TipoVocePOS {
  TRATTAMENTO
  PRODOTTO
  PACCHETTO
}

model TransazionePOS {
  id     String @id @default(cuid())
  hostId String
  host   Host   @relation(fields: [hostId], references: [id], onDelete: Cascade)

  // Collegamento opzionale
  prenotazioneId String?
  prenotazione   Prenotazione?    @relation(fields: [prenotazioneId], references: [id])
  appuntamentoId String?
  appuntamento   AppuntamentoSpa? @relation(fields: [appuntamentoId], references: [id])

  // Transazione
  numero String? // numero scontrino progressivo
  tipo   TipoTransazionePOS  @default(VENDITA)
  stato  StatoTransazionePOS @default(COMPLETATA)

  // Pagamento
  metodoPagamento MetodoPagamentoPOS @default(CONTANTI)
  tipoCarta       TipoCarta?
  ultime4Cifre    String?
  autorizzazione  String?

  // Importi
  subtotale         Float
  scontoPercentuale Float?
  scontoImporto     Float?
  totale            Float

  // Operatore
  operatore String
  note      String?

  // Gift Card payment
  giftCardId String?
  giftCard   GiftCard? @relation(fields: [giftCardId], references: [id])

  // Split payment
  guestNome       String?
  guestEmail      String?
  importoContanti Float?
  importoCarta    Float?
  importoBonifico Float?
  importoGiftCard Float?
  importoCamera   Float?
  riferimentoPOS  String?

  voci           VocePOS[]
  movimentiPunti MovimentoPunti[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([hostId, createdAt])
  @@index([prenotazioneId])
  @@map("transazioni_pos")
}

model VocePOS {
  id            String         @id @default(cuid())
  transazioneId String
  transazione   TransazionePOS @relation(fields: [transazioneId], references: [id], onDelete: Cascade)

  // Collegamento opzionale a servizio catalogo
  servizioId String?
  servizio   ServizioStruttura? @relation(fields: [servizioId], references: [id])

  trattamentoId String?
  trattamento   TrattamentoSpa? @relation(fields: [trattamentoId], references: [id])

  tipo           TipoVocePOS @default(PRODOTTO)
  descrizione    String
  quantita       Int         @default(1)
  prezzoUnitario Float
  sconto         Float?
  totale         Float

  createdAt DateTime @default(now())

  @@index([transazioneId])
  @@map("voci_pos")
}

// ─── Programma Fedeltà ────────────────────────────────────────────────────────

enum TipoMovimentoPunti {
  ACCUMULO
  UTILIZZO
  SCADENZA
  BONUS
  RETTIFICA
}

model ProgrammaFedelta {
  id     String @id @default(cuid())
  hostId String
  host   Host   @relation(fields: [hostId], references: [id], onDelete: Cascade)

  nome        String // "Club Benessere", "Loyalty SPA"
  descrizione String?
  attivo      Boolean @default(true)

  // Configurazione punti
  puntiPerEuro   Float @default(1) // quanti punti per ogni € speso
  valorePerPunto Float @default(0.01) // valore in € di ogni punto
  scadenzaMesi   Int? // mesi validità punti (null = mai)

  livelli   LivelloFedelta[]
  membri    MembroFedelta[]
  movimenti MovimentoPunti[]
  premi     PremioFedelta[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([hostId])
  @@map("programmi_fedelta")
}

model LivelloFedelta {
  id          String           @id @default(cuid())
  programmaId String
  programma   ProgrammaFedelta @relation(fields: [programmaId], references: [id], onDelete: Cascade)

  nome              String // "Bronze", "Silver", "Gold", "Platinum"
  puntiMinimi       Int // soglia punti per raggiungere il livello
  colore            String   @default("#6366f1")
  benefici          String[] @default([]) // descrizione benefici livello
  scontoPercentuale Float    @default(0)
  moltiplicatore    Float    @default(1.0) // moltiplicatore punti accumulo (es. Gold 2x)
  ordine            Int      @default(0)

  membri MembroFedelta[]

  createdAt DateTime @default(now())

  @@index([programmaId])
  @@map("livelli_fedelta")
}

model MembroFedelta {
  id          String           @id @default(cuid())
  programmaId String
  programma   ProgrammaFedelta @relation(fields: [programmaId], references: [id], onDelete: Cascade)
  ospiteId    String
  ospite      OspiteCRM        @relation(fields: [ospiteId], references: [id], onDelete: Cascade)

  puntiAccumulati Int             @default(0)
  puntiUtilizzati Int             @default(0)
  ultimaAttivita  DateTime?
  livelloId       String?
  livello         LivelloFedelta? @relation(fields: [livelloId], references: [id])

  dataIscrizione DateTime @default(now())

  movimenti MovimentoPunti[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([programmaId, ospiteId])
  @@index([programmaId])
  @@map("membri_fedelta")
}

model MovimentoPunti {
  id       String        @id @default(cuid())
  membroId String
  membro   MembroFedelta @relation(fields: [membroId], references: [id], onDelete: Cascade)

  tipo        TipoMovimentoPunti
  punti       Int
  saldoDopo   Int
  descrizione String

  // Collegamento opzionale ad appuntamento
  appuntamentoId String?
  appuntamento   AppuntamentoSpa? @relation(fields: [appuntamentoId], references: [id])

  // Collegamento opzionale a prenotazione alloggio (per accumulo da checkout)
  prenotazioneId String?
  prenotazione   Prenotazione?    @relation(fields: [prenotazioneId], references: [id])

  // Collegamento opzionale a premio riscattato (tipo UTILIZZO)
  premioId String?
  premio   PremioFedelta? @relation(fields: [premioId], references: [id])

  operatore String?
  note      String?

  createdAt          DateTime          @default(now())
  TransazionePOS     TransazionePOS?   @relation(fields: [transazionePOSId], references: [id])
  transazionePOSId   String?
  ProgrammaFedelta   ProgrammaFedelta? @relation(fields: [programmaFedeltaId], references: [id])
  programmaFedeltaId String?

  @@index([membroId])
  @@index([prenotazioneId])
  @@index([premioId])
  @@map("movimenti_punti")
}

// ─── Premi Fedeltà ────────────────────────────────────────────────────────────
//
// Catalogo premi riscattabili dai membri. Tipi supportati:
//   SCONTO_PRENOTAZIONE  — sconto fisso o % applicabile a una prenotazione futura
//   TRATTAMENTO_GRATIS   — trattamento SPA offerto (crea appuntamento con prezzo 0)
//   UPGRADE_CAMERA       — upgrade camera su prossima prenotazione (flag + addebito 0)
//   BONUS_PUNTI          — bonus punti (es. referral friend)
//   ALTRO                — premio generico (solo log, side-effect manuale)

enum TipoPremioFedelta {
  SCONTO_PRENOTAZIONE
  TRATTAMENTO_GRATIS
  UPGRADE_CAMERA
  BONUS_PUNTI
  ALTRO
}

model PremioFedelta {
  id          String            @id @default(cuid())
  programmaId String
  programma   ProgrammaFedelta  @relation(fields: [programmaId], references: [id], onDelete: Cascade)

  tipo            TipoPremioFedelta
  nome            String
  descrizione     String?
  immagine        String?
  costoInPunti    Int
  attivo          Boolean           @default(true)

  // Disponibilità
  disponibilitaMax    Int? // quanti riscatti totali disponibili (null = illimitato)
  riscattiContatore   Int               @default(0) // quanti già riscattati
  disponibilitaMembro Int? // quanti riscatti max per singolo membro (null = illimitato)

  // Link opzionali per side-effect automatico
  trattamentoSpaId String?
  datiApplicazione Json? // es. { scontoPercentuale: 10, valoreSconto: 50 }

  movimenti MovimentoPunti[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([programmaId, attivo])
  @@map("premi_fedelta")
}

// ─── SPA Waiting List & Turnaway ──────────────────────────────────────────────

enum StatoWaitingList {
  IN_ATTESA
  CONTATTATO
  PRENOTATO
  SCADUTO
  CANCELLATO
